-- NOTIFY
---------------------------------------------------------------------
function Library:Notify(o)
    o = o or {}
    local holder = Library.NotifyHolder
    if not holder then return end
    local dur = o.Duration or 4
    local wrap = New("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = holder})
    local card = New("Frame", {
        Position = UDim2.new(1.3, 0, 0, 0), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = Theme.BG, BorderSizePixel = 0, ClipsDescendants = true, Parent = wrap,
    })
    Corner(card, 8)
    Stroke(card, Theme.Purple, 1)
    local accent = New("Frame", {Size = UDim2.new(0, 3, 1, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = card})
    Gradient(accent, 90)
    local inner = New("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = card})
    New("UIPadding", {PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 12), Parent = inner})
    New("UIListLayout", {Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = inner})
    Txt(inner, {Text = o.Title or "Notice", Font = Enum.Font.GothamBold, TextSize = 14, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 1})
    Txt(inner, {
        Text = o.Content or "", TextSize = 13, TextColor3 = Theme.Sub, TextWrapped = true,
        TextYAlignment = Enum.TextYAlignment.Top, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2,
    })
    local prog = New("Frame", {AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = card})
    Gradient(prog)
    Tween(card, .4, {Position = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Back)
    Tween(prog, dur, {Size = UDim2.new(0, 0, 0, 2)}, Enum.EasingStyle.Linear)
    task.delay(dur, function()
        if card.Parent then
            local t = Tween(card, .3, {Position = UDim2.new(1.3, 0, 0, 0)}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            t.Completed:Wait()
            wrap:Destroy()
        end
    end)
end

