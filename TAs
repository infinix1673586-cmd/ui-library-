local function BuildElements(page, obj, connect)

    function obj:CreateSection(name)
        local f = New("Frame", {Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, Parent = page})
        Order(page, f)
        Txt(f, {Text = name or "Section", Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = Theme.Pink, Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(2, 0)})
        local ln = New("Frame", {Position = UDim2.new(0, 0, 1, -2), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = f})
        Gradient(ln)
    end

    function obj:CreateLabel(text)
        local row = Row(page, 32)
        local l = Txt(row, {Text = text or "Label", Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 1, 0), TextColor3 = Theme.Sub, TextSize = 13})
        return {Set = function(_, t) l.Text = t end}
    end

    function obj:CreateParagraph(o)
        o = o or {}
        local f = New("Frame", {
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = Theme.Row, BorderSizePixel = 0, Parent = page,
        })
        Order(page, f)
        Corner(f, 6)
        Stroke(f, Theme.Line, 1)
        New("UIPadding", {PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 10), Parent = f})
        New("UIListLayout", {Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder, Parent = f})
        local t = Txt(f, {Text = o.Title or "", Font = Enum.Font.GothamBold, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 1})
        local c = Txt(f, {
            Text = o.Content or "", TextSize = 13, TextColor3 = Theme.Sub, TextWrapped = true,
            TextYAlignment = Enum.TextYAlignment.Top, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2,
        })
        return {Set = function(_, title, content) t.Text = title or t.Text; c.Text = content or c.Text end}
    end

    function obj:CreateButton(o)
        if type(o) == "string" then o = {Name = o} end
        o = o or {}
        local row, st = Row(page, 38)
        local l = Txt(row, {Text = o.Name or "Button", Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -56, 1, 0)})
        local ic = New("Frame", {AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -8, .5, 0), Size = UDim2.fromOffset(26, 22), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = row})
        Corner(ic, 5)
        Gradient(ic, 45)
        Txt(ic, {Text = "›", Font = Enum.Font.GothamBold, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1)})
        local hit = New("TextButton", {Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = row})
        Hover(hit, row, st)
        hit.MouseButton1Click:Connect(function()
            Tween(row, .08, {BackgroundColor3 = Theme.Purple})
            task.delay(.1, function() Tween(row, .25, {BackgroundColor3 = Theme.RowHover}) end)
            Call(o.Callback)
        end)
        return {SetText = function(_, t) l.Text = t end}
    end

    function obj:CreateToggle(o)
        o = o or {}
        local row, st = Row(page, 38)
        Txt(row, {Text = o.Name or "Toggle", Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -70, 1, 0)})
        local track = New("Frame", {AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -12, .5, 0), Size = UDim2.fromOffset(40, 20), BackgroundColor3 = Theme.Off, BorderSizePixel = 0, Parent = row})
        Corner(track, 5)
        local g = Gradient(track, 0)
        g.Enabled = false
        local knob = New("Frame", {Position = UDim2.fromOffset(3, 3), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = track})
        Corner(knob, 4)
        local hit = New("TextButton", {Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = row})
        Hover(hit, row, st)
        local self = {Value = false}
        function self:Set(v, silent)
            self.Value = v and true or false
            Reg(o, self.Value)
            if self.Value then
                g.Enabled = true
                Tween(track, .2, {BackgroundColor3 = WHITE})
                Tween(knob, .2, {Position = UDim2.fromOffset(23, 3)}, Enum.EasingStyle.Back)
            else
                Tween(track, .2, {BackgroundColor3 = Theme.Off})
                Tween(knob, .2, {Position = UDim2.fromOffset(3, 3)}, Enum.EasingStyle.Back)
                task.delay(.2, function() if not self.Value then g.Enabled = false end end)
            end
            if not silent then Call(o.Callback, self.Value) end
        end
        function self:Get() return self.Value end
        hit.MouseButton1Click:Connect(function() self:Set(not self.Value) end)
        self:Set(o.Default or false, not o.Default)
        return self
    end

    function obj:CreateSlider(o)
        o = o or {}
        local min, max, inc = o.Min or 0, o.Max or 100, o.Increment or 1
        local suffix = o.Suffix or ""
        local row, st = Row(page, 54)
        Hover(row, row, st)
        Txt(row, {Text = o.Name or "Slider", Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -100, 0, 20)})
        local vl = Txt(row, {
            Text = "", TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = Theme.Pink, Font = Enum.Font.GothamBold, TextSize = 13,
            AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 6), Size = UDim2.fromOffset(86, 20),
        })
        local self = {Value = min}
        local setBar
        function self:Set(v, silent)
            v = math.clamp(v, min, max)
            v = math.floor((v - min) / inc + 0.5) * inc + min
            v = math.clamp(tonumber(string.format("%.4f", v)), min, max)
            self.Value = v
            vl.Text = tostring(v) .. suffix
            setBar((v - min) / math.max(max - min, 1e-9))
            Reg(o, v)
            if not silent then Call(o.Callback, v) end
        end
        function self:Get() return self.Value end
        local _
        _, setBar = MakeBar(connect, page, row, UDim2.new(0, 12, 0, 38), UDim2.new(1, -24, 0, 6), true, nil, function(a)
            self:Set(min + (max - min) * a)
        end)
        self:Set(o.Default or min, not o.Default)
        return self
    end

    function obj:CreateDropdown(o)
        o = o or {}
        local multi = o.Multi
        local options = o.Options or {}
        local row, st = Row(page, 38)
        Txt(row, {Text = o.Name or "Dropdown", Position = UDim2.fromOffset(12, 0), Size = UDim2.new(.4, -12, 0, 38)})
        local cur = Txt(row, {
            Text = "—", TextColor3 = Theme.Sub, TextXAlignment = Enum.TextXAlignment.Right, TextSize = 13,
            TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.new(.4, 0, 0, 0), Size = UDim2.new(.6, -34, 0, 38),
        })
        local arrow = Txt(row, {
            Text = "▼", TextSize = 10, TextColor3 = Theme.Pink, TextXAlignment = Enum.TextXAlignment.Center,
            AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 0), Size = UDim2.fromOffset(20, 38),
        })
        local hit = New("TextButton", {Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 38), Parent = row})
        Hover(hit, row, st)
        local list = New("ScrollingFrame", {
            Position = UDim2.fromOffset(8, 44), Size = UDim2.new(1, -16, 0, 0), BackgroundColor3 = Theme.Input,
            BorderSizePixel = 0, ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Pink,
            CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = row,
        })
        Corner(list, 6)
        New("UIListLayout", {Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list})
        New("UIPadding", {PaddingTop = UDim.new(0, 3), PaddingBottom = UDim.new(0, 3), PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 3), Parent = list})

        local value, sel, buttons, open = nil, {}, {}, false
        if multi then
            for _, v in ipairs(o.Default or {}) do sel[v] = true end
        else
            value = o.Default
        end
        local function getValue()
            if multi then
                local t = {}
                for _, op in ipairs(options) do if sel[op] then t[#t + 1] = op end end
                return t
            end
            return value
        end
        local function display()
            if multi then
                local t = {}
                for _, op in ipairs(options) do if sel[op] then t[#t + 1] = tostring(op) end end
                cur.Text = #t > 0 and table.concat(t, ", ") or "—"
            else
                cur.Text = value ~= nil and tostring(value) or "—"
            end
        end
        local function paint()
            for op, b in pairs(buttons) do
                local on = multi and sel[op] or (not multi and value == op)
                b.TextColor3 = on and Theme.Pink or Theme.Text
                b.BackgroundTransparency = on and 0 or 1
            end
        end
        local function setOpen(v)
            open = v
            local h = math.min(#options * 28 + 6, 150)
            Tween(row, .25, {Size = UDim2.new(1, 0, 0, v and (38 + h + 12) or 38)})
            Tween(list, .25, {Size = UDim2.new(1, -16, 0, v and h or 0)})
            Tween(arrow, .25, {Rotation = v and 180 or 0})
        end
        local function fire()
            display()
            Reg(o, getValue())
            Call(o.Callback, getValue())
        end
        local function build()
            for _, b in pairs(buttons) do b:Destroy() end
            buttons = {}
            for i, op in ipairs(options) do
                local b = New("TextButton", {
                    Text = tostring(op), Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = Theme.Text,
                    BackgroundColor3 = Theme.RowHover, BackgroundTransparency = 1, AutoButtonColor = false,
                    Size = UDim2.new(1, 0, 0, 26), LayoutOrder = i, BorderSizePixel = 0, Parent = list,
                })
                Corner(b, 5)
                b.MouseButton1Click:Connect(function()
                    if multi then sel[op] = not sel[op] or nil else value = op end
                    paint(); fire()
                    if not multi then setOpen(false) end
                end)
                buttons[op] = b
            end
            paint(); display()
        end
        hit.MouseButton1Click:Connect(function() setOpen(not open) end)
        build()
        Reg(o, getValue())

        local self = {}
        function self:Get() return getValue() end
        function self:Set(v)
            if multi then
                sel = {}
                for _, x in ipairs(v or {}) do sel[x] = true end
            else
                value = v
            end
            paint(); fire()
        end
        function self:Refresh(newOptions)
            options = newOptions or {}
            if multi then sel = {} else value = nil end
            build()
            if open then setOpen(true) end
        end
        if o.Default ~= nil then task.defer(Call, o.Callback, getValue()) end
        return self
    end

    function obj:CreateTextbox(o)
        o = o or {}
        local row, st = Row(page, 38)
        Hover(row, row, st)
        Txt(row, {Text = o.Name or "Textbox", Position = UDim2.fromOffset(12, 0), Size = UDim2.new(.5, -12, 1, 0)})
        local box = New("Frame", {AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -8, .5, 0), Size = UDim2.new(.5, -8, 0, 26), BackgroundColor3 = Theme.Input, BorderSizePixel = 0, Parent = row})
        Corner(box, 5)
        local bs = Stroke(box, Theme.Line, 1)
        local tb = New("TextBox", {
            Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -16, 1, 0), BackgroundTransparency = 1,
            Text = o.Default or "", PlaceholderText = o.Placeholder or "พิมพ์ที่นี่... / Type here...",
            PlaceholderColor3 = Color3.fromRGB(140, 130, 165), TextColor3 = Theme.Text,
            Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
            ClearTextOnFocus = false, ClipsDescendants = true, BorderSizePixel = 0, Parent = box,
        })
        tb.Focused:Connect(function() Tween(bs, .15, {Color = Theme.Pink}) end)
        tb.FocusLost:Connect(function(enter)
            Tween(bs, .15, {Color = Theme.Line})
            Reg(o, tb.Text)
            Call(o.Callback, tb.Text, enter)
        end)
        Reg(o, tb.Text)
        return {Get = function() return tb.Text end, Set = function(_, t) tb.Text = t end}
    end

    function obj:CreateKeybind(o)
        o = o or {}
        local key = o.Default or Enum.KeyCode.Unknown
        local row, st = Row(page, 38)
        Txt(row, {Text = o.Name or "Keybind", Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -110, 1, 0)})
        local btn = New("TextButton", {
            AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -8, .5, 0), Size = UDim2.fromOffset(86, 24),
            BackgroundColor3 = Theme.Input, AutoButtonColor = false, BorderSizePixel = 0,
            Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = Theme.Pink, Text = "", Parent = row,
        })
        Corner(btn, 5)
        Stroke(btn, Theme.Line, 1)
        local function keyName() return key == Enum.KeyCode.Unknown and "None" or key.Name end
        btn.Text = keyName()
        Hover(btn, row, st)
        local listening = false
        btn.MouseButton1Click:Connect(function() listening = true; btn.Text = "..." end)
        connect(UIS.InputBegan, function(i, gp)
            if listening then
                if i.UserInputType == Enum.UserInputType.Keyboard then
                    listening = false
                    key = (i.KeyCode == Enum.KeyCode.Escape) and Enum.KeyCode.Unknown or i.KeyCode
                    btn.Text = keyName()
                    Reg(o, key)
                    Call(o.Changed, key)
                end
            elseif not gp and key ~= Enum.KeyCode.Unknown and i.KeyCode == key then
                Call(o.Callback, key)
            end
        end)
        Reg(o, key)
        return {Get = function() return key end, Set = function(_, k) key = k; btn.Text = keyName() end}
    end

    function obj:CreateColorPicker(o)
        o = o or {}
        local color = o.Default or Theme.Pink
        local h, s, v = color:ToHSV()
        local row, st = Row(page, 38)
        Txt(row, {Text = o.Name or "Color", Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -70, 0, 38)})
        local swatch = New("Frame", {AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -12, 0, 19), Size = UDim2.fromOffset(34, 18), BackgroundColor3 = color, BorderSizePixel = 0, Parent = row})
        Corner(swatch, 4)
        Stroke(swatch, WHITE, 1, .6)
        local hit = New("TextButton", {Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 38), Parent = row})
        Hover(hit, row, st)

        local hueSeq = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)), ColorSequenceKeypoint.new(.17, Color3.fromHSV(.17, 1, 1)),
            ColorSequenceKeypoint.new(.33, Color3.fromHSV(.33, 1, 1)), ColorSequenceKeypoint.new(.5, Color3.fromHSV(.5, 1, 1)),
            ColorSequenceKeypoint.new(.67, Color3.fromHSV(.67, 1, 1)), ColorSequenceKeypoint.new(.83, Color3.fromHSV(.83, 1, 1)),
            ColorSequenceKeypoint.new(1, Color3.fromHSV(1, 1, 1)),
        })
        local function lbl(t, y)
            Txt(row, {Text = t, TextSize = 12, TextColor3 = Theme.Sub, Position = UDim2.fromOffset(12, y - 8), Size = UDim2.fromOffset(16, 16)})
        end
        lbl("H", 52) lbl("S", 74) lbl("V", 96)

        local self = {}
        local sTrack, vTrack, setH, setS, setV
        local function apply(silent)
            color = Color3.fromHSV(h, s, v)
            swatch.BackgroundColor3 = color
            sTrack:FindFirstChildOfClass("UIGradient").Color = ColorSequence.new(WHITE, Color3.fromHSV(h, 1, 1))
            vTrack:FindFirstChildOfClass("UIGradient").Color = ColorSequence.new(Color3.new(0, 0, 0), Color3.fromHSV(h, s, 1))
            Reg(o, color)
            if not silent then Call(o.Callback, color) end
        end
        local hTrack
        hTrack, setH = MakeBar(connect, page, row, UDim2.new(0, 34, 0, 48), UDim2.new(1, -50, 0, 8), false, hueSeq, function(a) h = a; apply() end)
        sTrack, setS = MakeBar(connect, page, row, UDim2.new(0, 34, 0, 70), UDim2.new(1, -50, 0, 8), false, ColorSequence.new(WHITE, WHITE), function(a) s = a; apply() end)
        vTrack, setV = MakeBar(connect, page, row, UDim2.new(0, 34, 0, 92), UDim2.new(1, -50, 0, 8), false, ColorSequence.new(WHITE, WHITE), function(a) v = a; apply() end)
        setH(h) setS(s) setV(v)
        apply(true)

        local open = false
        hit.MouseButton1Click:Connect(function()
            open = not open
            Tween(row, .25, {Size = UDim2.new(1, 0, 0, open and 118 or 38)})
        end)
        function self:Get() return color end
        function self:Set(c)
            h, s, v = c:ToHSV()
            setH(h) setS(s) setV(v)
            apply()
        end
        return self
    end
end

