function TabMethods:CreateToggle(config)
    config = config or {}
    local flag = config.Flag or config.Name or ("Toggle_" .. HttpService:GenerateGUID(false))
    local state = config.Default == true
    local row = makeRow(self, config.Name or "Toggle", config.Icon, 46)
    local switch = create("TextButton", {
        Name = "Switch",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(39, 21),
        BackgroundColor3 = state and Theme.Pink or Color3.fromRGB(82, 70, 91),
        Text = "",
        AutoButtonColor = false,
    }, row)
    corner(switch, 20)
    local knob = create("Frame", {
        Name = "Knob",
        Size = UDim2.fromOffset(15, 15),
        Position = state and UDim2.new(1, -18, 0.5, -7) or UDim2.fromOffset(3, 3),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    }, switch)
    corner(knob, 20)

    local function setState(value, callCallback)
        state = value == true
        Library.Flags[flag] = state
        tween(switch, 0.13, {BackgroundColor3 = state and Theme.Pink or Color3.fromRGB(82, 70, 91)})
        tween(knob, 0.13, {
            Position = state and UDim2.new(1, -18, 0.5, -7) or UDim2.fromOffset(3, 3)
        })
        if callCallback then safeCall(config.Callback, state) end
    end

    switch.Activated:Connect(function() setState(not state, true) end)
    setState(state, false)
    return {
        Frame = row,
        Set = function(_, value) setState(value, true) end,
        Get = function() return state end,
    }
end

function TabMethods:CreateSlider(config)
    config = config or {}
    local min = tonumber(config.Min) or 0
    local max = tonumber(config.Max) or 100
    if max <= min then max = min + 1 end
    local value = math.clamp(tonumber(config.Default) or min, min, max)
    local row = makeRow(self, config.Name or "Slider", config.Icon, 62)
    local valueLabel = makeLabel(row, tostring(value), UDim2.fromOffset(55, 20),
        UDim2.new(1, -66, 0, 2), 11, Theme.PinkLight, true)
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    local bar = create("Frame", {
        Position = UDim2.new(0, 12, 1, -17),
        Size = UDim2.new(1, -24, 0, 5),
        BackgroundColor3 = Color3.fromRGB(83, 69, 94),
        BorderSizePixel = 0,
    }, row)
    corner(bar, 5)
    local fill = create("Frame", {
        Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = Theme.Pink,
        BorderSizePixel = 0,
    }, bar)
    corner(fill, 5)
    local hit = create("TextButton", {
        BackgroundTransparency = 1,
        Text = "",
        Size = UDim2.new(1, 0, 0, 22),
        Position = UDim2.new(0, 0, 0.5, -11),
    }, bar)
    local dragging = false
    local function update(x)
        local alpha = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
        value = min + (max - min) * alpha
        if config.Rounding ~= nil then
            local decimals = math.max(0, tonumber(config.Rounding) or 0)
            local mult = 10 ^ decimals
            value = math.floor(value * mult + 0.5) / mult
        else
            value = math.floor(value + 0.5)
        end
        fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
        valueLabel.Text = tostring(value)
        safeCall(config.Callback, value)
    end
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input.Position.X)
        end
    end)
    local moveConn = UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input.Position.X)
        end
    end)
    local endConn = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    self.Window:TrackConnection(moveConn)
    self.Window:TrackConnection(endConn)
    safeCall(config.Callback, value)
    return row
end

