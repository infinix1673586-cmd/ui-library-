local Theme = {
    Pink     = Color3.fromRGB(255, 92, 190),
    Purple   = Color3.fromRGB(150, 90, 255),
    BG       = Color3.fromRGB(14, 10, 22),
    Side     = Color3.fromRGB(20, 15, 31),
    Row      = Color3.fromRGB(27, 21, 41),
    RowHover = Color3.fromRGB(37, 29, 57),
    Input    = Color3.fromRGB(18, 13, 28),
    Line     = Color3.fromRGB(58, 44, 86),
    Text     = Color3.fromRGB(246, 242, 255),
    Sub      = Color3.fromRGB(190, 180, 215),
    Off      = Color3.fromRGB(52, 44, 72),
}
Library.Theme = Theme

local WHITE = Color3.new(1, 1, 1)

local function GradSeq()
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0, Theme.Pink),
        ColorSequenceKeypoint.new(0.5, Theme.Purple),
        ColorSequenceKeypoint.new(1, Theme.Pink),
    })
end

---------------------------------------------------------------------
-- HELPERS
---------------------------------------------------------------------
local function New(class, props, kids)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then o[k] = v end
    end
    for _, c in ipairs(kids or {}) do c.Parent = o end
    if props and props.Parent then o.Parent = props.Parent end
    return o
end

local function Tween(o, t, p, style, dir)
    local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), p)
    tw:Play()
    return tw
end

local function Corner(p, r) return New("UICorner", {CornerRadius = UDim.new(0, r or 6), Parent = p}) end

local function Stroke(p, c, t, tr)
    return New("UIStroke", {
        Color = c or Theme.Line, Thickness = t or 1, Transparency = tr or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = p,
    })
end

local function Gradient(p, rot)
    return New("UIGradient", {Color = GradSeq(), Rotation = rot or 0, Parent = p})
end

local function Spin(g, speed)
    g.Rotation = 0
    TweenService:Create(g, TweenInfo.new(speed or 3, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1), {Rotation = 360}):Play()
end

local function Txt(parent, props)
    local d = {
        BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 14,
        TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
        BorderSizePixel = 0, Parent = parent,
    }
    for k, v in pairs(props) do d[k] = v end
    return New("TextLabel", d)
end

local function Call(f, ...)
    if f then
        local ok, err = pcall(f, ...)
        if not ok then warn("[SakuraUI] " .. tostring(err)) end
    end
end

local function Order(page, f)
    local n = (page:GetAttribute("n") or 0) + 1
    page:SetAttribute("n", n)
    f.LayoutOrder = n
end

local AllRows = setmetatable({}, {__mode = "k"})
Library.RowAlpha = 0
local function SetRowAlpha(a)
    Library.RowAlpha = a
    for f in pairs(AllRows) do
        if f.Parent then Tween(f, .25, {BackgroundTransparency = a}) end
    end
end

local function NormId(id)
    if id == nil then return nil end
    id = tostring(id):gsub("^%s+", ""):gsub("%s+$", "")
    if id == "" then return nil end
    return id
end

local function Row(page, h)
    local f = New("Frame", {
        Size = UDim2.new(1, 0, 0, h), BackgroundColor3 = Theme.Row, BackgroundTransparency = Library.RowAlpha,
        BorderSizePixel = 0, ClipsDescendants = true, Parent = page,
    })
    AllRows[f] = true
    Order(page, f)
    Corner(f, 6)
    return f, Stroke(f, Theme.Line, 1)
end

local function Hover(hit, row, stroke)
    hit.MouseEnter:Connect(function()
        Tween(row, .15, {BackgroundColor3 = Theme.RowHover})
        Tween(stroke, .15, {Color = Theme.Purple})
    end)
    hit.MouseLeave:Connect(function()
        Tween(row, .15, {BackgroundColor3 = Theme.Row})
        Tween(stroke, .15, {Color = Theme.Line})
    end)
end

local function Reg(o, v)
    if o and o.Flag then Library.Flags[o.Flag] = v end
end

local function GetParent()
    local ok, h = pcall(function() return gethui and gethui() end)
    if ok and h then return h end
    local ok2, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok2 and cg then
        local t = Instance.new("Folder")
        local ok3 = pcall(function() t.Parent = cg end)
        t:Destroy()
        if ok3 then return cg end
    end
    return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local function isPress(i)
    return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end
local function isMove(i)
    return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch
end

