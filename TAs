function Library:CreateWindow(cfg)
    cfg = cfg or {}
    local Win = {Tabs = {}, ToggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift}
    local conns = {}
    local function connect(sig, fn)
        local c = sig:Connect(fn)
        table.insert(conns, c)
        return c
    end

    local parentGui = GetParent()
    for _, v in ipairs(parentGui:GetChildren()) do
        if v.Name == "SakuraUI" then v:Destroy() end
    end
    local Gui = New("ScreenGui", {Name = "SakuraUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true, DisplayOrder = 999, Parent = parentGui})

    -- notify holder
    local nh = New("Frame", {Name = "Notify", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12), Size = UDim2.new(0, 270, 1, -24), BackgroundTransparency = 1, Parent = Gui})
    New("UIListLayout", {Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = nh})
    Library.NotifyHolder = nh

    -- drag helper
    local function Drag(handle, target, onClick)
        local dragging, moved, startIn, startUI = false, false, nil, nil
        handle.InputBegan:Connect(function(i)
            if isPress(i) then
                dragging, moved = true, false
                startIn, startUI = i.Position, target.Position
                local c
                c = i.Changed:Connect(function()
                    if i.UserInputState == Enum.UserInputState.End then
                        dragging = false
                        c:Disconnect()
                        if not moved and onClick then onClick() end
                    end
                end)
            end
        end)
        connect(UIS.InputChanged, function(i)
            if dragging and isMove(i) then
                local d = i.Position - startIn
                if d.Magnitude > 5 then moved = true end
                if moved then
                    target.Position = UDim2.new(startUI.X.Scale, startUI.X.Offset + d.X, startUI.Y.Scale, startUI.Y.Offset + d.Y)
                end
            end
        end)
    end

    -- main window
    local vp = workspace.CurrentCamera.ViewportSize
    local W = math.min(cfg.Width or 580, vp.X - 30)
    local H = math.min(cfg.Height or 380, vp.Y - 30)
    local SW = W < 520 and 118 or 150

    local Main = New("Frame", {
        Name = "Main", AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromOffset(W, H),
        BackgroundColor3 = Theme.BG, BorderSizePixel = 0, Active = true, Visible = false, Parent = Gui,
    })
    Corner(Main, 8)
    local ms = Stroke(Main, WHITE, 2)
    Spin(New("UIGradient", {Color = GradSeq(), Parent = ms}), 3) -- ขอบไล่สีวิ่งรอบ
    local Scale = New("UIScale", {Scale = 0, Parent = Main})

    -- top bar
    local Top = New("Frame", {Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, Parent = Main})
    local mark = New("Frame", {Position = UDim2.fromOffset(14, 11), Size = UDim2.fromOffset(4, 18), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = Top})
    Corner(mark, 2)
    Gradient(mark, 90)
    local tl = New("Frame", {Position = UDim2.fromOffset(26, 0), Size = UDim2.new(1, -80, 1, 0), BackgroundTransparency = 1, Parent = Top})
    New("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = tl})
    Txt(tl, {Text = cfg.Title or "SAKURA UI", Font = Enum.Font.GothamBold, TextSize = 15, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 20), LayoutOrder = 1})
    Txt(tl, {Text = cfg.Subtitle or "", TextSize = 12, TextColor3 = Theme.Sub, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 20), LayoutOrder = 2})

    local minBtn = New("TextButton", {
        AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -8, 0, 20), Size = UDim2.fromOffset(28, 26),
        BackgroundColor3 = Theme.Row, AutoButtonColor = false, Text = "—", Font = Enum.Font.GothamBold, TextSize = 14,
        TextColor3 = Theme.Text, BorderSizePixel = 0, Parent = Top,
    })
    Corner(minBtn, 5)
    minBtn.MouseEnter:Connect(function() Tween(minBtn, .15, {BackgroundColor3 = Theme.Purple}) end)
    minBtn.MouseLeave:Connect(function() Tween(minBtn, .15, {BackgroundColor3 = Theme.Row}) end)

    Drag(Top, Main)

    -- sidebar + pages
    local Side = New("Frame", {Position = UDim2.fromOffset(6, 44), Size = UDim2.new(0, SW, 1, -50), BackgroundColor3 = Theme.Side, BorderSizePixel = 0, Parent = Main})
    Corner(Side, 6)
    local TabList = New("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 0,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = Side,
    })
    New("UIListLayout", {Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = TabList})
    New("UIPadding", {PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), Parent = TabList})

    local Pages = New("Frame", {
        Position = UDim2.fromOffset(SW + 12, 44), Size = UDim2.new(1, -(SW + 18), 1, -50),
        BackgroundTransparency = 1, ClipsDescendants = true, Parent = Main,
    })

    -- floating toggle button (สี่เหลี่ยม UICorner + สีไล่)
    local Float, FloatIcon
    local visible = false
    function Win:SetVisible(v)
        if v == visible then return end
        visible = v
        if v then
            Main.Visible = true
            Tween(Scale, .4, {Scale = 1}, Enum.EasingStyle.Back)
        else
            local t = Tween(Scale, .22, {Scale = 0}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            t.Completed:Connect(function() if not visible then Main.Visible = false end end)
        end
        if FloatIcon then Tween(FloatIcon, .35, {Rotation = v and 180 or 0}, Enum.EasingStyle.Back) end
    end
    function Win:Toggle() self:SetVisible(not visible) end
    function Win:Notify(o) Library:Notify(o) end
    function Win:Destroy()
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        Gui:Destroy()
    end

    minBtn.MouseButton1Click:Connect(function() Win:SetVisible(false) end)

    if cfg.FloatButton ~= false then
        Float = New("TextButton", {
            Name = "Float", Text = "", AutoButtonColor = false, Position = UDim2.new(0, 16, .5, -24),
            Size = UDim2.fromOffset(48, 48), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = Gui,
        })
        Corner(Float, 10)
        Gradient(Float, 45)
        local fs = Stroke(Float, WHITE, 2)
        Spin(New("UIGradient", {Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, WHITE), ColorSequenceKeypoint.new(.5, Theme.Purple), ColorSequenceKeypoint.new(1, WHITE),
        }), Parent = fs}), 2.5)
        local fscale = New("UIScale", {Scale = 1, Parent = Float})
        if cfg.ToggleImage then
            FloatIcon = New("ImageLabel", {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromOffset(28, 28), BackgroundTransparency = 1, Image = cfg.ToggleImage, Parent = Float})
        else
            FloatIcon = Txt(Float, {
                Text = "✦", Font = Enum.Font.GothamBold, TextSize = 24, TextXAlignment = Enum.TextXAlignment.Center,
                AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromScale(1, 1),
            })
        end
        Drag(Float, Float, function()
            Tween(fscale, .08, {Scale = .85})
            task.delay(.08, function() Tween(fscale, .25, {Scale = 1}, Enum.EasingStyle.Back) end)
            Win:Toggle()
        end)
    end

    connect(UIS.InputBegan, function(i, gp)
        if not gp and i.KeyCode == Win.ToggleKey then Win:Toggle() end
    end)

    -- tabs
    local Active
    function Win:CreateTab(name, icon)
        if type(name) == "table" then icon = name.Icon; name = name.Name end
        local btn = New("TextButton", {
            Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = Theme.Row,
            BackgroundTransparency = 1, BorderSizePixel = 0, LayoutOrder = #Win.Tabs + 1, Parent = TabList,
        })
        Corner(btn, 6)
        local ind = New("Frame", {AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 0, .5, 0), Size = UDim2.fromOffset(3, 16), BackgroundColor3 = WHITE, BackgroundTransparency = 1, BorderSizePixel = 0, Parent = btn})
        Corner(ind, 2)
        Gradient(ind, 90)
        local lbl = Txt(btn, {
            Text = (icon and (icon .. "  ") or "") .. (name or "Tab"), Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -16, 1, 0),
            TextColor3 = Theme.Sub, TextTruncate = Enum.TextTruncate.AtEnd,
        })

        local page = New("ScrollingFrame", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false,
            ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Pink, CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = Pages,
        })
        New("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = page})
        New("UIPadding", {PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = page})

        local Tab = {Name = name}
        function Tab:Select()
            if Active == Tab then return end
            if Active then Active.Deselect() end
            Active = Tab
            page.Visible = true
            page.Position = UDim2.fromOffset(0, 14)
            Tween(page, .3, {Position = UDim2.new()})
            Tween(btn, .2, {BackgroundTransparency = 0})
            Tween(ind, .2, {BackgroundTransparency = 0})
            Tween(lbl, .2, {TextColor3 = Theme.Text})
        end
        function Tab.Deselect()
            page.Visible = false
            Tween(btn, .2, {BackgroundTransparency = 1})
            Tween(ind, .2, {BackgroundTransparency = 1})
            Tween(lbl, .2, {TextColor3 = Theme.Sub})
        end
        btn.MouseButton1Click:Connect(function() Tab:Select() end)
        btn.MouseEnter:Connect(function() if Active ~= Tab then Tween(lbl, .15, {TextColor3 = Theme.Text}) end end)
        btn.MouseLeave:Connect(function() if Active ~= Tab then Tween(lbl, .15, {TextColor3 = Theme.Sub}) end end)

        BuildElements(page, Tab, connect)
        table.insert(Win.Tabs, Tab)
        if #Win.Tabs == 1 then Tab:Select() end
        return Tab
    end

    if cfg.AutoOpen ~= false then task.defer(function() Win:SetVisible(true) end) end
    return Win
end

