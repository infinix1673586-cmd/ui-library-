function Library:RegisterIcons(t)
    for k, v in pairs(t or {}) do Library.Icons[k] = v end
end

local LucideModule, LucideTried
local function GetLucide()
    if LucideTried then return LucideModule end
    LucideTried = true
    pcall(function()
        LucideModule = loadstring(game:HttpGet("https://raw.githubusercontent.com/deividcomsono/lucide-roblox-direct/refs/heads/main/source.lua"))()
    end)
    return LucideModule
end

-- คืน {Image=, RectOffset=, RectSize=} หรือ {Text=} หรือ nil
local function ResolveIcon(icon)
    if icon == nil or icon == "" then return nil end
    if type(icon) == "number" then return {Image = "rbxassetid://" .. icon} end
    if type(icon) == "table" then
        local url = icon.Url or icon.Image
        if url then return {Image = url, RectOffset = icon.ImageRectOffset, RectSize = icon.ImageRectSize} end
        return nil
    end
    local s = tostring(icon)
    local reg = Library.Icons[s]
    if reg ~= nil and reg ~= s then return ResolveIcon(reg) end
    if s:match("^%d+$") then return {Image = "rbxassetid://" .. s} end
    if s:match("^rbxasset") or s:match("^https?://") then return {Image = s} end
    if s:match("^[%a][%w%-_]*$") then -- เหมือนชื่อไอคอน → ลอง Lucide
        if not Library.UseLucide then return nil end
        local L = GetLucide()
        if L then
            local ok, res = pcall(function()
                if type(L.GetAsset) == "function" then return L.GetAsset(s) end
                return L[s]
            end)
            if ok and type(res) == "table" then return ResolveIcon(res) end
            if ok and type(res) == "string" then return {Image = res} end
        end
        return nil
    end
    return {Text = s} -- อีโมจิ/สัญลักษณ์
end

local function MakeIcon(parent, icon, px, color, props)
    local r = ResolveIcon(icon)
    if not r then return nil end
    local o
    if r.Image then
        o = New("ImageLabel", {
            BackgroundTransparency = 1, Image = r.Image, ImageColor3 = color or WHITE, ScaleType = Enum.ScaleType.Fit,
            Size = UDim2.fromOffset(px, px), BorderSizePixel = 0, Parent = parent,
        })
        if r.RectOffset then o.ImageRectOffset = r.RectOffset; o.ImageRectSize = r.RectSize end
    else
        o = New("TextLabel", {
            BackgroundTransparency = 1, Text = r.Text, Font = Enum.Font.GothamBold, TextSize = px - 2,
            TextColor3 = color or Theme.Text, Size = UDim2.fromOffset(px, px), BorderSizePixel = 0, Parent = parent,
        })
    end
    for k, v in pairs(props or {}) do o[k] = v end
    return o
end

local function ColorProp(o) return o:IsA("ImageLabel") and "ImageColor3" or "TextColor3" end

-- ป้ายชื่อ element + ไอคอน (Icon = ...) ด้านซ้าย
local function NameLabel(row, o, fallback, size, y)
    y = y or 0
    local x = 12
    if o.Icon then
        local cy = (size.Y.Scale > 0) and UDim2.new(0, 12, .5, 0) or UDim2.new(0, 12, 0, y + size.Y.Offset / 2)
        local ic = MakeIcon(row, o.Icon, 16, Theme.Pink, {AnchorPoint = Vector2.new(0, .5), Position = cy})
        if ic then x = 34 end
    end
    return Txt(row, {
        Text = o.Name or fallback, Position = UDim2.fromOffset(x, y),
        Size = UDim2.new(size.X.Scale, size.X.Offset - (x - 12), size.Y.Scale, size.Y.Offset),
    })
end

