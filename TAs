function TabMethods:CreateDropdown(config)
    config = config or {}
    local options = config.Options or {}
    local selected = config.Default
    local row = makeRow(self, config.Name or "Dropdown", config.Icon, 46)
    local button = create("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.new(0.48, 0, 0, 28),
        BackgroundColor3 = Theme.Background,
        Text = tostring(selected or "เลือก"),
        TextColor3 = Theme.PinkLight,
        TextSize = 11,
        Font = Enum.Font.Gotham,
        AutoButtonColor = false,
    }, row)
    corner(button, 7)
    local opened = false
    local popup = create("Frame", {
        Name = "Options",
        Visible = false,
        Position = UDim2.new(0, 0, 1, 4),
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0,
        ZIndex = 20,
        ClipsDescendants = true,
    }, button)
    corner(popup, 7)
    local layout = create("UIListLayout", {Padding = UDim.new(0, 2)}, popup)
    local function rebuild()
        for _, child in ipairs(popup:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        for index, option in ipairs(options) do
            local item = create("TextButton", {
                LayoutOrder = index,
                Size = UDim2.new(1, 0, 0, 25),
                BackgroundColor3 = Theme.Row,
                BorderSizePixel = 0,
                Text = tostring(option),
                TextColor3 = Theme.Text,
                TextSize = 11,
                Font = Enum.Font.Gotham,
                ZIndex = 21,
            }, popup)
            item.Activated:Connect(function()
                selected = option
                button.Text = tostring(option)
                opened = false
                popup.Visible = false
                popup.Size = UDim2.new(1, 0, 0, 0)
                safeCall(config.Callback, option)
            end)
        end
    end
    rebuild()
    button.Activated:Connect(function()
        opened = not opened
        popup.Visible = opened
        local height = math.min(#options, 5) * 27
        tween(popup, 0.14, {Size = UDim2.new(1, 0, 0, opened and height or 0)})
    end)
    return {
        Frame = row,
        SetOptions = function(_, newOptions)
            options = newOptions or {}
            rebuild()
        end,
        Get = function() return selected end,
    }
end

