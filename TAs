        AutoButtonColor = false,
    }, row)
    corner(button, 6)
    button.Activated:Connect(function()
        local colors = {Theme.Pink, Theme.Purple, Color3.fromRGB(120, 190, 255), Color3.fromRGB(120, 220, 160), Color3.fromRGB(255, 210, 110), Color3.new(1, 1, 1)}
        local current = 1
        for i, item in ipairs(colors) do
            if item == color then current = i break end
        end
        current = current % #colors + 1
        color = colors[current]
        button.BackgroundColor3 = color
        safeCall(config.Callback, color)
    end)
    return row
end

local WindowMethods = {}
WindowMethods.__index = WindowMethods

function WindowMethods:TrackConnection(connection)
    table.insert(self.Connections, connection)
    return connection
end

function WindowMethods:CreateTab(name, icon)
    local index = #self.Tabs + 1
    local tabButton = create("TextButton", {
        Name = "Tab_" .. index,
        Size = UDim2.new(1, 0, 0, 39),
        BackgroundColor3 = Theme.Row,
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        LayoutOrder = index,
    }, self.TabList)
    corner(tabButton, 8)
    local iconObject = addIcon(tabButton, icon, UDim2.fromOffset(18, 18), UDim2.fromOffset(10, 10))
    local offset = iconObject and 37 or 12
    makeLabel(tabButton, name, UDim2.new(1, -offset - 8, 1, 0), UDim2.fromOffset(offset, 0), 12, Theme.Muted, true)

    local page = create("ScrollingFrame", {
        Name = "Page_" .. index,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1),
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Pink,
        Visible = false,
    }, self.PageHolder)
    create("UIPadding", {
        PaddingTop = UDim.new(0, 10),
        PaddingBottom = UDim.new(0, 10),
        PaddingLeft = UDim.new(0, 10),
        PaddingRight = UDim.new(0, 10),
    }, page)
    create("UIListLayout", {
        Padding = UDim.new(0, 7),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, page)

    local tab = setmetatable({
        Name = name,
        Button = tabButton,
        Content = page,
        Window = self,
    }, TabMethods)

    tabButton.Activated:Connect(function()
        self:SelectTab(tab)
    end)
    table.insert(self.Tabs, tab)
    if not self.SelectedTab then self:SelectTab(tab) end
    return tab
end

function WindowMethods:SelectTab(tab)
    if typeof(tab) == "number" then tab = self.Tabs[tab] end
    if not tab then return end
    for _, item in ipairs(self.Tabs) do
        local selected = item == tab
        item.Content.Visible = selected
        item.Button.BackgroundTransparency = selected and 0 or 1
        local label = item.Button:FindFirstChildWhichIsA("TextLabel")
        if label then label.TextColor3 = selected and Theme.Text or Theme.Muted end
    end
    self.SelectedTab = tab
    self.PageTitle.Text = tab.Name
end

function WindowMethods:SetVisible(state)
    state = state == true
    if self.Destroyed then return end
    self.Visible = state
    self.Frame.Visible = state
    if self.FloatButton then self.FloatButton.Visible = true end
end

function WindowMethods:Toggle()
    self:SetVisible(not self.Visible)
end

function WindowMethods:SetToggleImage(image)
    if not self.FloatButton then return end
    local kind, value = resolveIcon(image)
    if kind == "image" then
        self.FloatButton.Image = value
    end
end

function WindowMethods:SetToggleSize(size)
    if self.FloatButton then
        if typeof(size) == "number" then
            self.FloatButton.Size = UDim2.fromOffset(size, size)
        elseif typeof(size) == "UDim2" then
            self.FloatButton.Size = size
        end
    end
end

function WindowMethods:SetScale(scale)
    scale = math.clamp(tonumber(scale) or 1, 0.5, 1.5)
    if self.ScaleObject then self.ScaleObject.Scale = scale end
end

function WindowMethods:SetMainImage(image)
    local kind, value = resolveIcon(image)
    if self.MainImage and kind == "image" then
        self.MainImage.Image = value
        self.MainImage.Visible = true
    end
end

function WindowMethods:SetMainImageTransparency(value)
    if self.MainImage then
        self.MainImage.ImageTransparency = math.clamp(tonumber(value) or 0.88, 0, 1)
    end
end

function WindowMethods:ShowFloat(state)
    if self.FloatButton then self.FloatButton.Visible = state ~= false end
end

function WindowMethods:Notify(config)
    config = config or {}
    local toast = create("Frame", {
        Name = "Notification",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 320, 0, 18),
        Size = UDim2.fromOffset(280, 76),
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0,
        ZIndex = 50,
    }, self.ScreenGui)
    corner(toast, 10)
    stroke(toast, Theme.Pink, 0.25, 1)
    makeLabel(toast, config.Title or "Sakura UI", UDim2.new(1, -20, 0, 25),
        UDim2.fromOffset(10, 7), 13, Theme.PinkLight, true).ZIndex = 51
    makeLabel(toast, config.Content or config.Description or "", UDim2.new(1, -20, 0, 34),
        UDim2.fromOffset(10, 34), 11, Theme.Text, false).ZIndex = 51
    tween(toast, 0.22, {Position = UDim2.new(1, -15, 0, 18)})
    task.delay(tonumber(config.Duration) or 3, function()
        if toast and toast.Parent then
            tween(toast, 0.18, {Position = UDim2.new(1, 320, 0, 18)})
            task.delay(0.2, function()
                if toast then toast:Destroy() end
            end)
        end
    end)
    return toast
end

function WindowMethods:Destroy()
    if self.Destroyed then return end
    self.Destroyed = true
    for _, connection in ipairs(self.Connections) do
        pcall(function() connection:Disconnect() end)
    end
    self.Connections = {}
    if self.ScreenGui then self.ScreenGui:Destroy() end
    for i, window in ipairs(Library.Windows) do
        if window == self then table.remove(Library.Windows, i) break end
    end
end

local function makeDraggable(window, handle, target, clickCallback)
    local activeInput
    local startPointer
    local startPosition
    local moved = false
    local dragging = false

    handle.InputBegan:Connect(function(input)
        local inputType = input.UserInputType
        if inputType ~= Enum.UserInputType.MouseButton1 and inputType ~= Enum.UserInputType.Touch then
            return
        end
        if dragging then return end
        dragging = true
        activeInput = input
        startPointer = input.Position
        startPosition = target.Position
        moved = false
    end)

    window:TrackConnection(UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        local validMove = input.UserInputType == Enum.UserInputType.MouseMovement
            or (activeInput and activeInput.UserInputType == Enum.UserInputType.Touch and input == activeInput)
        if not validMove then return end
        local delta = input.Position - startPointer
        if delta.Magnitude > 5 then moved = true end
        if moved then
            target.Position = UDim2.new(
                startPosition.X.Scale, startPosition.X.Offset + delta.X,
                startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
            )
        end
    end))

    window:TrackConnection(UserInputService.InputEnded:Connect(function(input)
        if not dragging or not activeInput then return end
        local same = input == activeInput
        if activeInput.UserInputType == Enum.UserInputType.MouseButton1 then
            same = input.UserInputType == Enum.UserInputType.MouseButton1
        end
        if not same then return end
        dragging = false
        activeInput = nil
        if not moved and clickCallback then safeCall(clickCallback) end
    end))
end

function Library:CreateWindow(config)
    config = config or {}
    local playerGui = LocalPlayer:WaitForChild("PlayerGui")
    local screenGui = create("ScreenGui", {
        Name = "SakuraUI_" .. tostring(#self.Windows + 1),
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
    }, playerGui)

    local width = tonumber(config.Width) or 660
    local height = tonumber(config.Height) or 420
    local frame = create("Frame", {
        Name = "MainWindow",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(width, height),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true,
    }, screenGui)
    corner(frame, 15)
    stroke(frame, Theme.Stroke, 0.2, 1.2)
    create("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(39, 25, 51)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(22, 17, 31)),
        }),
        Rotation = 35,
    }, frame)

    local scaleObject = create("UIScale", {Scale = 1}, frame)
    local top = create("Frame", {
        Name = "TopBar",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 64),
        ZIndex = 2,
    }, frame)
    makeLabel(top, config.Title or "SAKURA UI", UDim2.new(1, -100, 0, 25),
        UDim2.fromOffset(18, 8), 18, Theme.Text, true)
    makeLabel(top, config.Subtitle or "Minimal Interface", UDim2.new(1, -100, 0, 18),
        UDim2.fromOffset(19, 34), 10, Theme.Muted, false)

    local close = create("TextButton", {
        Name = "Close",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -12, 0, 12),
        Size = UDim2.fromOffset(29, 29),
        BackgroundColor3 = Color3.fromRGB(91, 48, 78),
        Text = "×",
        TextColor3 = Theme.Text,
        TextSize = 21,
        Font = Enum.Font.Gotham,
        AutoButtonColor = false,
        ZIndex = 5,
    }, top)
    corner(close, 8)

    local body = create("Frame", {
        Name = "Body",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(12, 68),
        Size = UDim2.new(1, -24, 1, -80),
        ZIndex = 2,
    }, frame)

    local sidebar = create("Frame", {
        Name = "Sidebar",
        BackgroundColor3 = Theme.Panel,
        BackgroundTransparency = 0.08,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 166, 1, 0),
    }, body)
    corner(sidebar, 11)
    stroke(sidebar, Theme.Stroke, 0.48, 1)

    local tabList = create("ScrollingFrame", {
        Name = "TabList",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(8, 9),
        Size = UDim2.new(1, -16, 1, -18),
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Theme.Pink,
    }, sidebar)
    create("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, tabList)

    local content = create("Frame", {
        Name = "ContentFrame",
        BackgroundColor3 = Theme.Panel,
        BackgroundTransparency = 0.12,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(176, 0),
        Size = UDim2.new(1, -176, 1, 0),
        ClipsDescendants = true,
    }, body)
    corner(content, 11)
    stroke(content, Theme.Stroke, 0.48, 1)
    local pageTitle = makeLabel(content, "เลือกเมนู", UDim2.new(1, -26, 0, 28),
        UDim2.fromOffset(13, 7), 15, Theme.PinkLight, true)
    local pageHolder = create("Frame", {
        Name = "PageHolder",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(0, 39),
        Size = UDim2.new(1, 0, 1, -39),
    }, content)

    local window = setmetatable({
        ScreenGui = screenGui,
        Frame = frame,
        Tabs = {},
        TabList = tabList,
        PageHolder = pageHolder,
        PageTitle = pageTitle,
        Visible = true,
        Destroyed = false,
        Connections = {},
        ScaleObject = scaleObject,
    }, WindowMethods)

    close.Activated:Connect(function()
        window:Destroy()
    end)

    -- Drag only the empty top bar area. Buttons keep their own click behavior.
    makeDraggable(window, top, frame)

    local toggleImage = config.ToggleImage
    if toggleImage ~= nil then
        local kind, value = resolveIcon(toggleImage)
        if kind == "image" then
            local float = create("ImageButton", {
                Name = "SakuraToggle",
                Size = UDim2.fromOffset(54, 54),
                Position = UDim2.new(0, 18, 0.5, -27),
                BackgroundColor3 = Theme.Panel,
                Image = value,
                ScaleType = Enum.ScaleType.Crop,
                AutoButtonColor = false,
                ZIndex = 10,
            }, screenGui)
            corner(float, 15)
            stroke(float, Theme.Pink, 0.15, 1.5)
            window.FloatButton = float
            makeDraggable(window, float, float, function()
                window:Toggle()
            end)
        end
    end

    if config.MainImage then
        local kind, value = resolveIcon(config.MainImage)
        if kind == "image" then
            window.MainImage = create("ImageLabel", {
                Name = "MainBackgroundImage",
                BackgroundTransparency = 1,
                Image = value,
                ImageTransparency = math.clamp(tonumber(config.MainImageTransparency) or 0.88, 0, 1),
                ScaleType = Enum.ScaleType.Crop,
                Size = UDim2.fromScale(1, 1),
                ZIndex = 0,
            }, frame)
        end
    end

    table.insert(self.Windows, window)
    return window
end

return Library
