-- SLIDER BAR (ใช้ซ้ำทั้ง Slider และ ColorPicker)
---------------------------------------------------------------------
local function MakeBar(connect, page, parent, pos, size, fill, seq, cb)
    local track = New("Frame", {
        Position = pos, Size = size, BorderSizePixel = 0,
        BackgroundColor3 = fill and Theme.Off or WHITE, Parent = parent,
    })
    Corner(track, 3)
    if seq then New("UIGradient", {Color = seq, Parent = track}) end
    local bar
    if fill then
        bar = New("Frame", {Size = UDim2.fromScale(0, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = track})
        Corner(bar, 3)
        Gradient(bar)
    end
    local thumb = New("Frame", {
        AnchorPoint = Vector2.new(.5, .5), Position = UDim2.new(0, 0, .5, 0),
        Size = UDim2.fromOffset(12, 12), BackgroundColor3 = WHITE, ZIndex = 3, BorderSizePixel = 0, Parent = track,
    })
    Corner(thumb, 4)
    Stroke(thumb, Theme.Pink, 2)
    local hit = New("TextButton", {
        Text = "", BackgroundTransparency = 1, ZIndex = 4,
        Position = UDim2.new(0, -6, 0, -9), Size = UDim2.new(1, 12, 1, 18), Parent = track,
    })
    local function set(a)
        a = math.clamp(a, 0, 1)
        thumb.Position = UDim2.new(a, 0, .5, 0)
        if bar then bar.Size = UDim2.fromScale(a, 1) end
    end
    local dragging = false
    local function upd(i)
        local a = (i.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
        a = math.clamp(a, 0, 1)
        set(a)
        cb(a)
    end
    hit.InputBegan:Connect(function(i)
        if isPress(i) then dragging = true; page.ScrollingEnabled = false; upd(i) end
    end)
    connect(UIS.InputChanged, function(i) if dragging and isMove(i) then upd(i) end end)
    connect(UIS.InputEnded, function(i)
        if dragging and isPress(i) then dragging = false; page.ScrollingEnabled = true end
    end)
    return track, set
end

