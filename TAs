function Library:Notify(options)
    options = options or {}
    local holder = Library.NotifyHolder
    if not holder then return end

    local duration = math.max(tonumber(options.Duration) or 4, 1)
    local wrap = New("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, Parent = holder
    })
    local card = New("Frame", {
        Position = UDim2.new(1.2, 0, 0, 0), Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0, ClipsDescendants = true, Parent = wrap
    })
    Corner(card, 9)
    Stroke(card, Theme.Purple, 1, 0.05)

    local accent = New("Frame", {
        Size = UDim2.new(0, 3, 1, 0), BackgroundColor3 = Theme.Pink,
        BorderSizePixel = 0, Parent = card
    })
    SakuraGradient(accent, 90)

    local inner = New("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, Parent = card
    })
    New("UIPadding", {
        PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 11),
        PaddingTop = UDim.new(0, 9), PaddingBottom = UDim.new(0, 12), Parent = inner
    })
    New("UIListLayout", {Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder, Parent = inner})
    Txt(inner, {
        Text = options.Title or "Sakura", Font = Enum.Font.GothamBold,
        TextSize = 14, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 1
    })
    Txt(inner, {
        Text = options.Content or "", TextSize = 13, TextColor3 = Theme.Sub,
        TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2
    })
    local progress = New("Frame", {
        AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = Theme.Pink,
        BorderSizePixel = 0, Parent = card
    })
    SakuraGradient(progress)
    Tween(card, 0.35, {Position = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Back)
    Tween(progress, duration, {Size = UDim2.new(0, 0, 0, 2)}, Enum.EasingStyle.Linear)
    task.delay(duration, function()
        if card.Parent then
            Tween(card, 0.25, {Position = UDim2.new(1.2, 0, 0, 0)}).Completed:Wait()
            wrap:Destroy()
        end
    end)
end

---------------------------------------------------------------------
-- BAR CONTROL (slider / color picker)
---------------------------------------------------------------------
local function MakeBar(connect, page, parent, position, size, fillEnabled, sequence, callback)
    local track = New("Frame", {
        Position = position, Size = size,
        BackgroundColor3 = fillEnabled and Theme.Off or Theme.White,
        BorderSizePixel = 0, Parent = parent
    })
    Corner(track, 4)
    if sequence then New("UIGradient", {Color = sequence, Parent = track}) end

    local fill
    if fillEnabled then
        fill = New("Frame", {
            Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.White,
            BorderSizePixel = 0, Parent = track
        })
        Corner(fill, 4)
        SakuraGradient(fill)
    end

    local knob = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(13, 13), BackgroundColor3 = Theme.White,
        BorderSizePixel = 0, ZIndex = 3, Parent = track
    })
    Corner(knob, 6)
    Stroke(knob, Theme.Pink, 2)

    local hit = New("TextButton", {
        Text = "", BackgroundTransparency = 1,
        Position = UDim2.new(0, -7, 0, -9), Size = UDim2.new(1, 14, 1, 18),
        ZIndex = 4, Parent = track
    })

    local function set(alpha)
        alpha = math.clamp(alpha, 0, 1)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        if fill then fill.Size = UDim2.fromScale(alpha, 1) end
    end

    local dragging = false
    local function update(input)
        local alpha = (input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
        alpha = math.clamp(alpha, 0, 1)
        set(alpha)
        callback(alpha)
    end

    hit.InputBegan:Connect(function(input)
        if IsPress(input) then
            dragging = true
            page.ScrollingEnabled = false
            update(input)
        end
    end)
    connect(UIS.InputChanged, function(input)
        if dragging and IsMove(input) then update(input) end
    end)
    connect(UIS.InputEnded, function(input)
        if dragging and IsPress(input) then
            dragging = false
            page.ScrollingEnabled = true
        end
    end)
    return track, set
end

---------------------------------------------------------------------
-- ELEMENT BUILDERS
---------------------------------------------------------------------
local function BuildElements(page, object, connect)
    function object:CreateSection(name)
        local frame = New("Frame", {
            Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, Parent = page
        })
        AddOrder(page, frame)
        Txt(frame, {
            Text = tostring(name or "SECTION"):upper(), Font = Enum.Font.GothamBold,
            TextSize = 11, TextColor3 = Theme.PinkLight,
            Position = UDim2.fromOffset(3, 0), Size = UDim2.new(1, -6, 0, 21)
        })
        local line = New("Frame", {
            Position = UDim2.new(0, 0, 1, -3), Size = UDim2.new(1, 0, 0, 2),
            BackgroundColor3 = Theme.Purple, BorderSizePixel = 0, Parent = frame
        })
        Corner(line, 2)
        SakuraGradient(line)
    end

    function object:CreateLabel(options)
        if type(options) ~= "table" then options = {Name = options} end
        local row = MakeRow(page, 36)
        local label = LabelName(row, options, "Label", 20)
        label.TextColor3 = Theme.Sub
        return {
            Set = function(_, value) label.Text = tostring(value) end,
            SetText = function(_, value) label.Text = tostring(value) end
        }
    end

    function object:CreateParagraph(options)
        options = options or {}
        local frame = New("Frame", {
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = Theme.Row, BackgroundTransparency = Library.RowAlpha,
            BorderSizePixel = 0, Parent = page
        })
        Rows[frame] = true
        AddOrder(page, frame)
        Corner(frame, 8)
        Stroke(frame, Theme.Line, 1, 0.15)
        New("UIPadding", {
            PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
            PaddingTop = UDim.new(0, 9), PaddingBottom = UDim.new(0, 10), Parent = frame
        })
        New("UIListLayout", {Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = frame})
        local title = Txt(frame, {
            Text = options.Title or "", Font = Enum.Font.GothamBold,
            TextSize = 14, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 1
        })
        local content = Txt(frame, {
            Text = options.Content or "", TextSize = 13, TextColor3 = Theme.Sub,
            TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2
        })
        return {
            Set = function(_, newTitle, newContent)
                if newTitle ~= nil then title.Text = tostring(newTitle) end
                if newContent ~= nil then content.Text = tostring(newContent) end
            end
        }
    end

    function object:CreateButton(options)
        if type(options) == "string" then options = {Name = options} end
        options = options or {}
        local row, outline = MakeRow(page, 42)
        local label = LabelName(row, options, "Button", 55)
        local badge = New("Frame", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -9, 0.5, 0),
            Size = UDim2.fromOffset(27, 25), BackgroundColor3 = Theme.Purple,
            BorderSizePixel = 0, Parent = row
        })
        Corner(badge, 7)
        SakuraGradient(badge, 35)
        Txt(badge, {
            Text = "›", Font = Enum.Font.GothamBold, TextSize = 21,
            TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1)
        })
        local hit = New("TextButton", {
            Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = row
        })
        Hover(hit, row, outline)
        hit.MouseButton1Click:Connect(function()
            Tween(badge, 0.1, {Size = UDim2.fromOffset(31, 28)})
            task.delay(0.1, function()
                if badge.Parent then Tween(badge, 0.16, {Size = UDim2.fromOffset(27, 25)}) end
            end)
            Call(options.Callback)
        end)
        return {SetText = function(_, value) label.Text = tostring(value) end}
    end

    function object:CreateToggle(options)
        options = options or {}
        local row, outline = MakeRow(page, 42)
        LabelName(row, options, "Toggle", 72)
        local track = New("Frame", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
            Size = UDim2.fromOffset(43, 22), BackgroundColor3 = Theme.Off,
            BorderSizePixel = 0, Parent = row
        })
        Corner(track, 7)
        local knob = New("Frame", {
            Position = UDim2.fromOffset(3, 3), Size = UDim2.fromOffset(16, 16),
            BackgroundColor3 = Theme.White, BorderSizePixel = 0, Parent = track
        })
        Corner(knob, 6)
        Stroke(knob, Theme.Pink, 1, 0.5)
        local hit = New("TextButton", {
            Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = row
        })
        Hover(hit, row, outline)

        local self = {Value = false}
        function self:Set(value, silent)
            self.Value = value and true or false
            Flag(options, self.Value)
            Tween(track, 0.18, {BackgroundColor3 = self.Value and Theme.Pink or Theme.Off})
            Tween(knob, 0.2, {
                Position = self.Value and UDim2.fromOffset(24, 3) or UDim2.fromOffset(3, 3)
            }, Enum.EasingStyle.Back)
            if not silent then Call(options.Callback, self.Value) end
        end
        function self:Get() return self.Value end
        hit.MouseButton1Click:Connect(function() self:Set(not self.Value) end)
        self:Set(options.Default == true, true)
        if options.Default == true then task.defer(Call, options.Callback, true) end
        return self
    end

    function object:CreateSlider(options)
        options = options or {}
        local minimum = tonumber(options.Min) or 0
        local maximum = tonumber(options.Max) or 100
        local increment = math.max(tonumber(options.Increment) or 1, 0.0001)
        local suffix = options.Suffix or ""
        if maximum < minimum then maximum = minimum end

        local row = MakeRow(page, 58)
        LabelName(row, options, "Slider", 105)
        local valueText = Txt(row, {
            Text = "", Font = Enum.Font.GothamBold, TextSize = 13,
            TextColor3 = Theme.PinkLight, TextXAlignment = Enum.TextXAlignment.Right,
            AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 7),
            Size = UDim2.fromOffset(90, 19)
        })
        local self = {Value = minimum}
        local setBar

        function self:Set(value, silent)
            value = math.clamp(tonumber(value) or minimum, minimum, maximum)
            value = math.floor((value - minimum) / increment + 0.5) * increment + minimum
            value = math.clamp(tonumber(string.format("%.4f", value)), minimum, maximum)
            self.Value = value
            valueText.Text = tostring(value) .. suffix
            setBar(maximum == minimum and 0 or (value - minimum) / (maximum - minimum))
            Flag(options, value)
            if not silent then Call(options.Callback, value) end
        end
        function self:Get() return self.Value end

        local _, setter = MakeBar(connect, page, row,
            UDim2.new(0, 13, 0, 41), UDim2.new(1, -26, 0, 6),
            true, nil, function(alpha)
                self:Set(minimum + (maximum - minimum) * alpha)
            end
        )
        setBar = setter
        self:Set(options.Default ~= nil and options.Default or minimum, true)
        if options.Default ~= nil then task.defer(Call, options.Callback, self.Value) end
        return self
    end

    function object:CreateDropdown(options)
        options = options or {}
        local choices = options.Options or {}
        local multi = options.Multi == true
        local selected = {}
        local current = options.Default
        local opened = false
        local buttons = {}

        if multi and type(options.Default) == "table" then
            for _, value in ipairs(options.Default) do selected[value] = true end
        end

        local row, outline = MakeRow(page, 42)
        LabelName(row, options, "Dropdown", 105)
        local currentText = Txt(row, {
            Text = "Select...", TextColor3 = Theme.Sub, TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd,
            Position = UDim2.new(0.42, 0, 0, 0), Size = UDim2.new(0.58, -39, 0, 42)
        })
        local arrow = Txt(row, {
            Text = "⌄", Font = Enum.Font.GothamBold, TextSize = 17,
            TextColor3 = Theme.PinkLight, TextXAlignment = Enum.TextXAlignment.Center,
            AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -7, 0, 0),
            Size = UDim2.fromOffset(24, 42)
        })
        local hit = New("TextButton", {
            Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 42), Parent = row
        })
        Hover(hit, row, outline)

        local list = New("ScrollingFrame", {
            Position = UDim2.fromOffset(8, 47), Size = UDim2.new(1, -16, 0, 0),
            BackgroundColor3 = Theme.Input, BorderSizePixel = 0, ScrollBarThickness = 3,
            ScrollBarImageColor3 = Theme.Pink, CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = row
        })
        Corner(list, 7)
        Stroke(list, Theme.Line, 1, 0.2)
        New("UIListLayout", {Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list})
        New("UIPadding", {
            PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
            PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4), Parent = list
        })

        local function getValue()
            if not multi then return current end
            local result = {}
            for _, choice in ipairs(choices) do
                if selected[choice] then table.insert(result, choice) end
            end
            return result
        end

        local function display()
            if multi then
                local values, strings = getValue(), {}
                for _, value in ipairs(values) do table.insert(strings, tostring(value)) end
                currentText.Text = #strings > 0 and table.concat(strings, ", ") or "Select..."
            else
                currentText.Text = current ~= nil and tostring(current) or "Select..."
            end
        end

        local function paint()
            for choice, button in pairs(buttons) do
                local active = multi and selected[choice] or (not multi and current == choice)
                button.TextColor3 = active and Theme.PinkLight or Theme.Text
                button.BackgroundColor3 = active and Theme.RowHover or Theme.Input
                button.BackgroundTransparency = active and 0 or 1
            end
        end

        local function fire()
            display()
            Flag(options, getValue())
            Call(options.Callback, getValue())
        end

        local function setOpen(state)
            opened = state
            local h = math.min(#choices * 29 + 9, 155)
            Tween(row, 0.22, {Size = UDim2.new(1, 0, 0, state and (42 + h + 12) or 42)})
            Tween(list, 0.22, {Size = UDim2.new(1, -16, 0, state and h or 0)})
            Tween(arrow, 0.2, {Rotation = state and 180 or 0})
        end

        local function rebuild()
            for _, button in pairs(buttons) do button:Destroy() end
            buttons = {}
            for index, choice in ipairs(choices) do
                local button = New("TextButton", {
                    Text = tostring(choice), Font = Enum.Font.GothamMedium,
                    TextSize = 13, TextColor3 = Theme.Text,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    BackgroundColor3 = Theme.Input, BackgroundTransparency = 1,
                    AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 27),
                    LayoutOrder = index, BorderSizePixel = 0, Parent = list
                })
                Corner(button, 5)
                New("UIPadding", {PaddingLeft = UDim.new(0, 8), Parent = button})
                button.MouseButton1Click:Connect(function()
                    if multi then selected[choice] = not selected[choice] or nil
                    else current = choice end
                    paint()
                    fire()
                    if not multi then setOpen(false) end
                end)
                buttons[choice] = button
            end
            paint()
            display()
        end

        hit.MouseButton1Click:Connect(function() setOpen(not opened) end)
        rebuild()
        Flag(options, getValue())

        local self = {}
        function self:Get() return getValue() end
        function self:Set(value)
            if multi then
                selected = {}
                for _, item in ipairs(value or {}) do selected[item] = true end
            else
                current = value
            end
            paint()
            fire()
        end
        function self:Refresh(newChoices)
            choices = newChoices or {}
            selected = {}
            if not multi then current = nil end
            rebuild()
            if opened then setOpen(true) end
            Flag(options, getValue())
        end
        if options.Default ~= nil then task.defer(Call, options.Callback, getValue()) end
        return self
    end

