        })
        Corner(button, 6)
        Stroke(button, Theme.Line, 1, 0.1)
        local function keyName()
            return key == Enum.KeyCode.Unknown and "None" or key.Name
        end
        button.Text = keyName()
        Hover(button, row, outline)
        local listening = false
        button.MouseButton1Click:Connect(function()
            listening = true
            button.Text = "Press key..."
            Tween(button, 0.12, {BackgroundColor3 = Theme.RowHover})
        end)
        connect(UIS.InputBegan, function(input, processed)
            if listening then
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    listening = false
                    key = input.KeyCode == Enum.KeyCode.Escape and Enum.KeyCode.Unknown or input.KeyCode
                    button.Text = keyName()
                    Flag(options, key)
                    Call(options.Changed, key)
                end
            elseif not processed and key ~= Enum.KeyCode.Unknown and input.KeyCode == key then
                Call(options.Callback, key)
            end
        end)
        Flag(options, key)
        return {
            Get = function() return key end,
            Set = function(_, newKey)
                key = newKey or Enum.KeyCode.Unknown
                button.Text = keyName()
                Flag(options, key)
            end
        }
    end

    function object:CreateColorPicker(options)
        options = options or {}
        local color = options.Default or Theme.Pink
        local hue, saturation, value = color:ToHSV()
        local row, outline = MakeRow(page, 42)
        LabelName(row, options, "Color Picker", 75)
        local swatch = New("Frame", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
            Size = UDim2.fromOffset(37, 21), BackgroundColor3 = color,
            BorderSizePixel = 0, Parent = row
        })
        Corner(swatch, 6)
        Stroke(swatch, Theme.White, 1, 0.55)
        local hit = New("TextButton", {
            Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 42), Parent = row
        })
        Hover(hit, row, outline)

        local hueSequence = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
            ColorSequenceKeypoint.new(0.17, Color3.fromHSV(0.17, 1, 1)),
            ColorSequenceKeypoint.new(0.33, Color3.fromHSV(0.33, 1, 1)),
            ColorSequenceKeypoint.new(0.5, Color3.fromHSV(0.5, 1, 1)),
            ColorSequenceKeypoint.new(0.67, Color3.fromHSV(0.67, 1, 1)),
            ColorSequenceKeypoint.new(0.83, Color3.fromHSV(0.83, 1, 1)),
            ColorSequenceKeypoint.new(1, Color3.fromHSV(1, 1, 1))
        })

        for _, pair in ipairs({{"H", 58}, {"S", 82}, {"V", 106}}) do
            Txt(row, {
                Text = pair[1], TextSize = 11, Font = Enum.Font.GothamBold,
                TextColor3 = Theme.Sub, Position = UDim2.fromOffset(12, pair[2] - 7),
                Size = UDim2.fromOffset(15, 16)
            })
        end

        local hueTrack, satTrack, valTrack
        local setHue, setSat, setVal
        local expanded = false

        local function apply(silent)
            color = Color3.fromHSV(hue, saturation, value)
            swatch.BackgroundColor3 = color
            if satTrack then
                satTrack:FindFirstChildOfClass("UIGradient").Color =
                    ColorSequence.new(Theme.White, Color3.fromHSV(hue, 1, 1))
            end
            if valTrack then
                valTrack:FindFirstChildOfClass("UIGradient").Color =
                    ColorSequence.new(Color3.new(0, 0, 0), Color3.fromHSV(hue, saturation, 1))
            end
            Flag(options, color)
            if not silent then Call(options.Callback, color) end
        end

        hueTrack, setHue = MakeBar(connect, page, row,
            UDim2.new(0, 34, 0, 54), UDim2.new(1, -48, 0, 7),
            false, hueSequence, function(a) hue = a; apply() end)
        satTrack, setSat = MakeBar(connect, page, row,
            UDim2.new(0, 34, 0, 78), UDim2.new(1, -48, 0, 7),
            false, ColorSequence.new(Theme.White, Theme.Pink),
            function(a) saturation = a; apply() end)
        valTrack, setVal = MakeBar(connect, page, row,
            UDim2.new(0, 34, 0, 102), UDim2.new(1, -48, 0, 7),
            false, ColorSequence.new(Color3.new(0, 0, 0), Theme.White),
            function(a) value = a; apply() end)

        setHue(hue)
        setSat(saturation)
        setVal(value)
        apply(true)

        hit.MouseButton1Click:Connect(function()
            expanded = not expanded
            Tween(row, 0.22, {Size = UDim2.new(1, 0, 0, expanded and 128 or 42)})
        end)

        return {
            Get = function() return color end,
            Set = function(_, newColor)
                hue, saturation, value = newColor:ToHSV()
                setHue(hue)
                setSat(saturation)
                setVal(value)
                apply()
            end
        }
    end
