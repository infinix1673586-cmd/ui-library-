    })

    -----------------------------------------------------------------
    -- DRAG
    -----------------------------------------------------------------
    local function Drag(handle, target, onClick)
        local dragging, moved = false, false
        local startInput, startPosition

        handle.InputBegan:Connect(function(input)
            if not IsPress(input) then return end
            dragging, moved = true, false
            startInput, startPosition = input.Position, target.Position

            local ended
            ended = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    ended:Disconnect()
                    if not moved and onClick then onClick() end
                end
            end)
        end)

        Connect(connections, UIS.InputChanged, function(input)
            if dragging and IsMove(input) then
                local delta = input.Position - startInput
                if delta.Magnitude > 5 then moved = true end
                if moved then
                    target.Position = UDim2.new(
                        startPosition.X.Scale, startPosition.X.Offset + delta.X,
                        startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
                    )
                end
            end
        end)

        Connect(connections, UIS.InputEnded, function(input)
            if dragging and IsPress(input) then dragging = false end
        end)
    end

    Drag(top, Main)

    -----------------------------------------------------------------
    -- WINDOW METHODS + FLOAT BUTTON
    -----------------------------------------------------------------
    local visible = false
    local Float, FloatIcon, isPhoto

    local function BuildFloatIcon()
        if not Float then return end
        if FloatIcon then FloatIcon:Destroy(); FloatIcon = nil end
        local resolved = Win.ToggleImage and ResolveIcon(Win.ToggleImage)

        if resolved and resolved.Image then
            isPhoto = true
            FloatIcon = New("ImageLabel", {
                Name = "Icon", BackgroundTransparency = 1,
                Image = resolved.Image, ScaleType = Enum.ScaleType.Crop,
                Size = UDim2.fromScale(1, 1), BorderSizePixel = 0,
                ZIndex = 2, Parent = Float
            })
            if resolved.RectOffset then
                FloatIcon.ImageRectOffset = resolved.RectOffset
                FloatIcon.ImageRectSize = resolved.RectSize
            end
            Corner(FloatIcon, 11)
        else
            isPhoto = false
            FloatIcon = Txt(Float, {
                Text = resolved and resolved.Text or "✿",
                Font = Enum.Font.GothamBold,
                TextSize = math.floor(Win.FloatSize * 0.48),
                TextColor3 = Theme.White,
                TextXAlignment = Enum.TextXAlignment.Center,
                Size = UDim2.fromScale(1, 1), ZIndex = 2
            })
            FloatIcon.Rotation = visible and 180 or 0
        end
    end

    function Win:SetVisible(state)
        state = state and true or false
        if state == visible then return end
        visible = state

        if state then
            Main.Visible = true
            Tween(scale, 0.32, {Scale = uiScale}, Enum.EasingStyle.Back)
        else
            local tw = Tween(scale, 0.2, {Scale = 0}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            tw.Completed:Connect(function()
                if not visible then Main.Visible = false end
            end)
        end

        if FloatIcon and not isPhoto then
            Tween(FloatIcon, 0.25, {Rotation = state and 180 or 0}, Enum.EasingStyle.Back)
        end
    end

    function Win:Toggle() self:SetVisible(not visible) end
    function Win:Notify(options) Library:Notify(options) end

    function Win:Destroy()
        for _, connection in ipairs(connections) do
            pcall(function() connection:Disconnect() end)
        end
        Gui:Destroy()
        if Library.NotifyHolder == notifyHolder then Library.NotifyHolder = nil end
    end

    function Win:SetToggleImage(id)
        Win.ToggleImage = CleanId(id)
        BuildFloatIcon()
        persist()
    end

    function Win:SetToggleSize(px)
        Win.FloatSize = math.clamp(tonumber(px) or 48, 32, 96)
        if Float then
            Tween(Float, 0.18, {Size = UDim2.fromOffset(Win.FloatSize, Win.FloatSize)})
            if FloatIcon and not isPhoto then
                FloatIcon.TextSize = math.floor(Win.FloatSize * 0.48)
            end
        end
        persist()
    end

    function Win:ShowFloat(state)
        if Float then Float.Visible = state and true or false end
    end

    function Win:SetScale(value)
        uiScale = math.clamp(tonumber(value) or 1, 0.6, 1.3)
        if visible then Tween(scale, 0.2, {Scale = uiScale}) end
        persist()
    end

    function Win:SetToggleKey(key)
        if typeof(key) == "EnumItem" then
            Win.ToggleKey = key
            persist()
        end
    end

    local function ApplyMainImage()
        local resolved = Win.MainImage and ResolveIcon(Win.MainImage)
        if resolved and resolved.Image then
            bg.Image = resolved.Image
            bg.ImageTransparency = Win.MainImageTransparency
            bg.Visible = true
            Side.BackgroundTransparency = 0.18
            SetRowAlpha(0.16)
        else
            bg.Visible = false
            bg.Image = ""
            Side.BackgroundTransparency = 0
            SetRowAlpha(0)
        end
    end

    function Win:SetMainImage(id)
        Win.MainImage = CleanId(id)
        ApplyMainImage()
        persist()
    end

    function Win:SetMainImageTransparency(alpha)
        Win.MainImageTransparency = math.clamp(tonumber(alpha) or 0.55, 0, 0.95)
        bg.ImageTransparency = Win.MainImageTransparency
        persist()
    end

    ApplyMainImage()
    minimize.MouseButton1Click:Connect(function() Win:SetVisible(false) end)

    if config.FloatButton ~= false then
        Float = New("TextButton", {
            Name = "Float", Text = "", AutoButtonColor = false,
            Position = UDim2.new(0, 18, 0.5, -24),
            Size = UDim2.fromOffset(Win.FloatSize, Win.FloatSize),
            BackgroundColor3 = Theme.Pink, BorderSizePixel = 0, Parent = Gui
        })
        Corner(Float, 12)
        SakuraGradient(Float, 35)
        Stroke(Float, Theme.PinkLight, 1.5, 0)
        local floatScale = New("UIScale", {Scale = 1, Parent = Float})
        BuildFloatIcon()

        Drag(Float, Float, function()
            Tween(floatScale, 0.08, {Scale = 0.88})
            task.delay(0.08, function()
                if floatScale.Parent then Tween(floatScale, 0.2, {Scale = 1}, Enum.EasingStyle.Back) end
            end)
            Win:Toggle()
        end)
    end

    Connect(connections, UIS.InputBegan, function(input, processed)
        if not processed and input.KeyCode == Win.ToggleKey then Win:Toggle() end
    end)

