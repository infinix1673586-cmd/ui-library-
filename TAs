local function safeCall(callback, ...)
    if typeof(callback) ~= "function" then return end
    local ok, err = pcall(callback, ...)
    if not ok then
        warn("[Sakura UI] Callback error:", err)
    end
end

local function create(className, props, parent)
    local object = Instance.new(className)
    for key, value in pairs(props or {}) do
        local ok, err = pcall(function()
            object[key] = value
        end)
        if not ok then
            warn("[Sakura UI] Property", key, "could not be set:", err)
        end
    end
    object.Parent = parent
    return object
end

local function corner(parent, radius)
    return create("UICorner", {
        CornerRadius = UDim.new(0, radius or 9)
    }, parent)
end

local function stroke(parent, color, transparency, thickness)
    return create("UIStroke", {
        Color = color or Theme.Stroke,
        Transparency = transparency or 0,
        Thickness = thickness or 1,
    }, parent)
end

local function tween(object, duration, properties)
    if not object or not object.Parent then return end
    local animation = TweenService:Create(
        object,
        TweenInfo.new(duration or 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        properties
    )
    animation:Play()
    return animation
end

function Library:RegisterIcons(iconTable)
    if typeof(iconTable) ~= "table" then return self end
    for name, icon in pairs(iconTable) do
        if typeof(name) == "string" then
            self.Icons[name] = icon
        end
    end
    return self
end

local function resolveIcon(icon)
    if icon == nil then return nil, nil end
    if typeof(icon) == "number" then
        return "image", "rbxassetid://" .. tostring(icon)
    end
    if typeof(icon) ~= "string" then return nil, nil end

    local registered = Library.Icons[icon]
    if registered ~= nil then
        if registered == icon then return "text", icon end
        return resolveIcon(registered)
    end

    if icon:match("^rbxassetid://") then
        return "image", icon
    end
    if icon:match("^%d+$") then
        return "image", "rbxassetid://" .. icon
    end
    return "text", icon
end

local function addIcon(parent, icon, size, position)
    local kind, value = resolveIcon(icon)
    if not kind then return nil end
    if kind == "image" then
        return create("ImageLabel", {
            Name = "Icon",
            BackgroundTransparency = 1,
            Image = value,
            ScaleType = Enum.ScaleType.Fit,
            Size = size or UDim2.fromOffset(18, 18),
            Position = position or UDim2.new(),
        }, parent)
    end
    return create("TextLabel", {
        Name = "Icon",
        BackgroundTransparency = 1,
        Text = value,
        TextColor3 = Theme.PinkLight,
        TextSize = 16,
        Font = Enum.Font.Gotham,
        Size = size or UDim2.fromOffset(18, 18),
        Position = position or UDim2.new(),
    }, parent)
end

local function makeLabel(parent, text, size, position, textSize, color, bold)
    return create("TextLabel", {
        BackgroundTransparency = 1,
        Text = tostring(text or ""),
        TextColor3 = color or Theme.Text,
        TextSize = textSize or 13,
        Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        Size = size,
        Position = position or UDim2.new(),
        TextWrapped = true,
    }, parent)
end

local function makeRow(tab, name, icon, height)
    local row = create("Frame", {
        Name = "Control_" .. tostring(name or "Item"),
        BackgroundColor3 = Theme.Row,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, height or 46),
    }, tab.Content)
    corner(row, 9)
    local iconObject = addIcon(row, icon, UDim2.fromOffset(19, 19), UDim2.fromOffset(11, 13))
    local textX = iconObject and 40 or 13
    makeLabel(row, name or "Control", UDim2.new(1, -textX - 12, 1, 0),
        UDim2.fromOffset(textX, 0), 13, Theme.Text, true)
    return row
end

