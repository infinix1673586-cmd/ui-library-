            page.Visible = true
            page.Position = UDim2.fromOffset(0, 9)
            Tween(page, 0.22, {Position = UDim2.new()})
            Tween(button, 0.18, {BackgroundTransparency = 0})
            Tween(indicator, 0.18, {BackgroundTransparency = 0})
            Tween(label, 0.18, {TextColor3 = Theme.Text})
            if iconObject then Tween(iconObject, 0.18, {[iconProperty] = Theme.PinkLight}) end
        end

        function Tab:Deselect()
            page.Visible = false
            Tween(button, 0.18, {BackgroundTransparency = 1})
            Tween(indicator, 0.18, {BackgroundTransparency = 1})
            Tween(label, 0.18, {TextColor3 = Theme.Sub})
            if iconObject then Tween(iconObject, 0.18, {[iconProperty] = Theme.Sub}) end
        end

        button.MouseButton1Click:Connect(function() Tab:Select() end)
        button.MouseEnter:Connect(function()
            if Active ~= Tab then Tween(label, 0.14, {TextColor3 = Theme.Text}) end
        end)
        button.MouseLeave:Connect(function()
            if Active ~= Tab then Tween(label, 0.14, {TextColor3 = Theme.Sub}) end
        end)

        BuildElements(page, Tab, function(signal, callback)
            return Connect(connections, signal, callback)
        end)

        table.insert(Win.Tabs, Tab)
        if #Win.Tabs == 1 then Tab:Select() end
        return Tab
    end

    -----------------------------------------------------------------
    -- CUSTOMIZE TAB
    -----------------------------------------------------------------
    function Win:CreateSettingsTab(name, icon)
        local Tab = Win:CreateTab(name or "Customize", icon or "settings")

        Tab:CreateSection("FLOAT BUTTON")
        local toggleImageBox = Tab:CreateTextbox({
            Name = "Toggle image ID", Icon = "image",
            Placeholder = "Asset ID / rbxassetid://...",
            Default = Win.ToggleImage and tostring(Win.ToggleImage) or "",
            Callback = function(value)
                Win:SetToggleImage(value)
                Library:Notify({
                    Title = "Toggle image updated",
                    Content = value ~= "" and ("Image: " .. value) or "Using Sakura default icon",
                    Duration = 3
                })
            end
        })
        Tab:CreateButton({
            Name = "Reset toggle image", Icon = "rotate-ccw",
            Callback = function()
                toggleImageBox:Set("")
                Win:SetToggleImage(nil)
            end
        })
        Tab:CreateSlider({
            Name = "Float button size", Icon = "maximize",
            Min = 32, Max = 96, Default = Win.FloatSize, Suffix = "px",
            Callback = function(value) Win:SetToggleSize(value) end
        })
        Tab:CreateToggle({
            Name = "Show float button", Icon = "eye", Default = true,
            Callback = function(value) Win:ShowFloat(value) end
        })

        Tab:CreateSection("BACKGROUND")
        local bgBox = Tab:CreateTextbox({
            Name = "Main image ID", Icon = "image",
            Placeholder = "Background asset ID",
            Default = Win.MainImage and tostring(Win.MainImage) or "",
            Callback = function(value) Win:SetMainImage(value) end
        })
        Tab:CreateButton({
            Name = "Reset background", Icon = "eraser",
            Callback = function()
                bgBox:Set("")
                Win:SetMainImage(nil)
            end
        })
        Tab:CreateSlider({
            Name = "Image visibility", Icon = "sun",
            Min = 5, Max = 100, Increment = 5,
            Default = math.floor((1 - Win.MainImageTransparency) * 100 + 0.5),
            Suffix = "%",
            Callback = function(value) Win:SetMainImageTransparency(1 - value / 100) end
        })

        Tab:CreateSection("WINDOW")
        Tab:CreateSlider({
            Name = "UI scale", Icon = "scaling",
            Min = 60, Max = 130, Increment = 5,
            Default = math.floor(uiScale * 100 + 0.5), Suffix = "%",
            Callback = function(value) Win:SetScale(value / 100) end
        })
        Tab:CreateKeybind({
            Name = "Toggle key", Icon = "keyboard", Default = Win.ToggleKey,
            Changed = function(key) Win:SetToggleKey(key) end
        })
        Tab:CreateButton({
            Name = "Destroy UI", Icon = "x",
            Callback = function() Win:Destroy() end
        })
        return Tab
    end

    if config.AutoOpen ~= false then
        task.defer(function() Win:SetVisible(true) end)
    end

    return Win
end

