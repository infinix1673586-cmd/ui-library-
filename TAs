--[[
SAKURA UI LIBRARY v1.3
Pink / Violet theme, readable text, polished controls, icon support.
Keeps the v1.2 public API:
CreateWindow, CreateTab, CreateSettingsTab, CreateSection, CreateLabel,
CreateParagraph, CreateButton, CreateToggle, CreateSlider, CreateDropdown,
CreateTextbox, CreateKeybind, CreateColorPicker.
]]

local Library = {Flags = {}, Icons = {}, UseLucide = true, Version = "1.3.0"}
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")

local Theme = {
    Pink = Color3.fromRGB(255, 119, 190),
    PinkLight = Color3.fromRGB(255, 184, 220),
    Purple = Color3.fromRGB(174, 126, 255),
    PurpleDark = Color3.fromRGB(112, 77, 174),
    BG = Color3.fromRGB(17, 13, 25),
    Side = Color3.fromRGB(24, 18, 35),
    Panel = Color3.fromRGB(30, 23, 44),
    Row = Color3.fromRGB(37, 29, 53),
    RowHover = Color3.fromRGB(51, 39, 71),
    Input = Color3.fromRGB(22, 17, 33),
    Line = Color3.fromRGB(79, 60, 104),
    Text = Color3.fromRGB(250, 247, 255),
    Sub = Color3.fromRGB(205, 195, 222),
    Muted = Color3.fromRGB(157, 146, 178),
    Off = Color3.fromRGB(72, 59, 89),
    White = Color3.new(1, 1, 1)
}
Library.Theme = Theme

local function New(class, props, children)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then obj[k] = v end
    end
    for _, child in ipairs(children or {}) do child.Parent = obj end
    if props and props.Parent then obj.Parent = props.Parent end
    return obj
end

local function Tween(obj, duration, props, style, direction)
    local tw = TweenService:Create(obj, TweenInfo.new(
        duration, style or Enum.EasingStyle.Quad,
        direction or Enum.EasingDirection.Out
    ), props)
    tw:Play()
    return tw
end

local function Corner(parent, radius)
    return New("UICorner", {CornerRadius = UDim.new(0, radius or 8), Parent = parent})
end

local function Stroke(parent, color, thickness, transparency)
    return New("UIStroke", {
        Color = color or Theme.Line, Thickness = thickness or 1,
        Transparency = transparency or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent
    })
end

local function SakuraGradient(parent, rotation)
    return New("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Theme.Pink),
            ColorSequenceKeypoint.new(0.5, Theme.Purple),
            ColorSequenceKeypoint.new(1, Theme.PinkLight)
        }),
        Rotation = rotation or 0, Parent = parent
    })
end

local function Txt(parent, props)
    local p = {
        BackgroundTransparency = 1, BorderSizePixel = 0,
        Font = Enum.Font.GothamMedium, TextSize = 14,
        TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center, Parent = parent
    }
    for k, v in pairs(props or {}) do p[k] = v end
    return New("TextLabel", p)
end

local function Call(fn, ...)
    if type(fn) == "function" then
        local ok, err = pcall(fn, ...)
        if not ok then warn("[SakuraUI] " .. tostring(err)) end
    end
end

local function Flag(options, value)
    if options and options.Flag then Library.Flags[options.Flag] = value end
end

local function CleanId(value)
    if value == nil then return nil end
    value = tostring(value):gsub("^%s+", ""):gsub("%s+$", "")
    return value ~= "" and value or nil
end

local function IsPress(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end

local function IsMove(input)
    return input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
end

local function GetParent()
    local ok, hui = pcall(function() return gethui and gethui() end)
    if ok and hui then return hui end
    local core = game:GetService("CoreGui")
    local test = Instance.new("Folder")
    local success = pcall(function() test.Parent = core end)
    test:Destroy()
    if success then return core end
    return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local function Connect(connections, signal, callback)
    local c = signal:Connect(callback)
    table.insert(connections, c)
    return c
end

---------------------------------------------------------------------
-- ICONS: Lucide name / asset ID / rbxassetid / emoji / registered key
---------------------------------------------------------------------
function Library:RegisterIcons(iconTable)
    for key, value in pairs(iconTable or {}) do Library.Icons[key] = value end
end

local Lucide, LucideLoaded
local function GetLucide()
    if LucideLoaded then return Lucide end
    LucideLoaded = true
    if not Library.UseLucide then return nil end
    pcall(function()
        Lucide = loadstring(game:HttpGet(
            "https://raw.githubusercontent.com/deividcomsono/lucide-roblox-direct/refs/heads/main/source.lua"
        ))()
    end)
    return Lucide
end

local function ResolveIcon(icon)
    if icon == nil or icon == "" then return nil end
    if type(icon) == "number" then return {Image = "rbxassetid://" .. icon} end
    if type(icon) == "table" then
        local image = icon.Url or icon.Image
        if image then
            return {Image = image, RectOffset = icon.ImageRectOffset, RectSize = icon.ImageRectSize}
        end
        return nil
    end

    local name = tostring(icon)
    if Library.Icons[name] ~= nil and Library.Icons[name] ~= name then
        return ResolveIcon(Library.Icons[name])
    end
    if name:match("^%d+$") then return {Image = "rbxassetid://" .. name} end
    if name:match("^rbxasset") or name:match("^https?://") then return {Image = name} end

    -- Plain emoji/symbols are text. Alphabetic names are treated as Lucide names.
    if name:match("^[%a][%w%-_]*$") then
        local module = GetLucide()
        if module then
            local ok, result = pcall(function()
                if type(module.GetAsset) == "function" then return module.GetAsset(name) end
                return module[name]
            end)
            if ok and type(result) == "string" then return {Image = result} end
            if ok and type(result) == "table" then
                local image = result.Url or result.Image
                if image then
                    return {Image = image, RectOffset = result.ImageRectOffset, RectSize = result.ImageRectSize}
                end
            end
        end
        return nil
    end
    return {Text = name}
end

local function MakeIcon(parent, icon, size, color, extra)
    local data = ResolveIcon(icon)
    if not data then return nil end
    local obj
    if data.Image then
        obj = New("ImageLabel", {
            BackgroundTransparency = 1, Image = data.Image,
            ImageColor3 = color or Theme.Text, ScaleType = Enum.ScaleType.Fit,
            Size = UDim2.fromOffset(size, size), BorderSizePixel = 0, Parent = parent
        })
        if data.RectOffset then
            obj.ImageRectOffset = data.RectOffset
            obj.ImageRectSize = data.RectSize
        end
    else
        obj = Txt(parent, {
            Text = data.Text, Font = Enum.Font.GothamBold,
            TextSize = size - 1, TextColor3 = color or Theme.Text,
            TextXAlignment = Enum.TextXAlignment.Center,
            Size = UDim2.fromOffset(size, size)
        })
    end
    for k, v in pairs(extra or {}) do obj[k] = v end
    return obj
end

local function IconColorProp(icon)
    return icon:IsA("ImageLabel") and "ImageColor3" or "TextColor3"
end

local Rows = setmetatable({}, {__mode = "k"})
Library.RowAlpha = 0

local function SetRowAlpha(alpha)
    Library.RowAlpha = alpha
    for row in pairs(Rows) do
        if row.Parent then Tween(row, 0.2, {BackgroundTransparency = alpha}) end
    end
end

local function AddOrder(page, object)
    local n = (page:GetAttribute("SakuraOrder") or 0) + 1
    page:SetAttribute("SakuraOrder", n)
    object.LayoutOrder = n
end

local function MakeRow(page, height)
    local row = New("Frame", {
        Size = UDim2.new(1, 0, 0, height), BackgroundColor3 = Theme.Row,
        BackgroundTransparency = Library.RowAlpha, BorderSizePixel = 0,
        ClipsDescendants = true, Parent = page
    })
    Rows[row] = true
    AddOrder(page, row)
    Corner(row, 8)
    return row, Stroke(row, Theme.Line, 1, 0.15)
end

local function LabelName(row, options, fallback, rightSpace)
    local x = 13
    if options and options.Icon then
        local icon = MakeIcon(row, options.Icon, 17, Theme.PinkLight, {
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 12, 0.5, 0)
        })
        if icon then x = 38 end
    end
    return Txt(row, {
        Text = options and options.Name or fallback or "Element",
        Position = UDim2.new(0, x, 0, 0),
        Size = UDim2.new(1, -(x + (rightSpace or 18)), 1, 0),
        TextSize = 13, TextColor3 = Theme.Text,
        TextTruncate = Enum.TextTruncate.AtEnd
    })
end

local function Hover(hit, row, outline)
    hit.MouseEnter:Connect(function()
        Tween(row, 0.15, {BackgroundColor3 = Theme.RowHover})
        Tween(outline, 0.15, {Color = Theme.Pink, Transparency = 0})
    end)
    hit.MouseLeave:Connect(function()
        Tween(row, 0.15, {BackgroundColor3 = Theme.Row})
        Tween(outline, 0.15, {Color = Theme.Line, Transparency = 0.15})
    end)
end

