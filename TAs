    Win.MainImageTransparency = math.clamp(saved.MainImageTransparency or config.MainImageTransparency or 0.55, 0, 0.95)
    Win.FloatSize = math.clamp(saved.FloatSize or config.FloatSize or 48, 32, 96)
    local uiScale = math.clamp(saved.UIScale or config.Scale or 1, 0.6, 1.3)
