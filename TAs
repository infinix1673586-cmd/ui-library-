-- WINDOW
---------------------------------------------------------------------
function Library:CreateWindow(cfg)
    cfg = cfg or {}
    local Win = {Tabs = {}}
    local conns = {}
    local function connect(sig, fn)
        local c = sig:Connect(fn)
        table.insert(conns, c)
        return c
    end

    -- ค่าที่เซฟไว้ (ถ้ามี) ทับค่า default
    local Saved = (cfg.SaveSettings ~= false) and LoadSaved() or {}
    if Saved.ToggleImage ~= nil then
        Win.ToggleImage = (Saved.ToggleImage ~= "") and Saved.ToggleImage or nil
    else
        Win.ToggleImage = cfg.ToggleImage
    end
    if Saved.MainImage ~= nil then
        Win.MainImage = (Saved.MainImage ~= "") and Saved.MainImage or nil
    else
        Win.MainImage = cfg.MainImage or cfg.Mainlmage -- รับทั้ง MainImage และ Mainlmage (พิมพ์ l เล็ก)
    end
    Win.MainImageTransparency = math.clamp(Saved.MainImageTrans or cfg.MainImageTransparency or .5, 0, .95)
    Win.FloatSize = math.clamp(Saved.FloatSize or cfg.FloatSize or 48, 32, 96)
    local uiScale = math.clamp(Saved.UIScale or cfg.Scale or 1, .6, 1.3)
    Win.ToggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift
    if Saved.ToggleKey then
        local ok, k = pcall(function() return Enum.KeyCode[Saved.ToggleKey] end)
        if ok and k then Win.ToggleKey = k end
    end
    local function persist()
        if cfg.SaveSettings == false then return end
        Saved.ToggleImage = Win.ToggleImage ~= nil and tostring(Win.ToggleImage) or ""
        Saved.FloatSize = Win.FloatSize
        Saved.UIScale = uiScale
        Saved.ToggleKey = Win.ToggleKey.Name
        Saved.MainImage = Win.MainImage ~= nil and tostring(Win.MainImage) or ""
        Saved.MainImageTrans = Win.MainImageTransparency
        WriteSaved(Saved)
    end

    local parentGui = GetParent()
    for _, v in ipairs(parentGui:GetChildren()) do
        if v.Name == "SakuraUI" then v:Destroy() end
    end
    local Gui = New("ScreenGui", {Name = "SakuraUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true, DisplayOrder = 999, Parent = parentGui})

    local nh = New("Frame", {Name = "Notify", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12), Size = UDim2.new(0, 270, 1, -24), BackgroundTransparency = 1, Parent = Gui})
    New("UIListLayout", {Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = nh})
    Library.NotifyHolder = nh

    local function Drag(handle, target, onClick)
        local dragging, moved, startIn, startUI = false, false, nil, nil
        handle.InputBegan:Connect(function(i)
            if isPress(i) then
                dragging, moved = true, false
                startIn, startUI = i.Position, target.Position
                local c
                c = i.Changed:Connect(function()
                    if i.UserInputState == Enum.UserInputState.End then
                        dragging = false
                        c:Disconnect()
                        if not moved and onClick then onClick() end
                    end
                end)
            end
        end)
        connect(UIS.InputChanged, function(i)
            if dragging and isMove(i) then
                local d = i.Position - startIn
                if d.Magnitude > 5 then moved = true end
                if moved then
                    target.Position = UDim2.new(startUI.X.Scale, startUI.X.Offset + d.X, startUI.Y.Scale, startUI.Y.Offset + d.Y)
                end
            end
        end)
    end

    -- main window
    local vp = workspace.CurrentCamera.ViewportSize
    local W = math.min(cfg.Width or 580, vp.X - 30)
    local H = math.min(cfg.Height or 380, vp.Y - 30)
    local SW = W < 520 and 118 or 150

    local Main = New("Frame", {
        Name = "Main", AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromOffset(W, H),
        BackgroundColor3 = Theme.BG, BorderSizePixel = 0, Active = true, Visible = false, Parent = Gui,
    })
    Corner(Main, 8)
    local ms = Stroke(Main, WHITE, 2)
    Spin(New("UIGradient", {Color = GradSeq(), Parent = ms}), 3) -- ขอบไล่สีวิ่งรอบ
    local Scale = New("UIScale", {Scale = 0, Parent = Main})

    -- รูปพื้นหลัง UI หลัก (MainImage)
    local BG = New("ImageLabel", {
        Name = "BG", BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Crop, Size = UDim2.fromScale(1, 1),
        BorderSizePixel = 0, Visible = false, Image = "", Parent = Main,
    })
    Corner(BG, 8)

    -- top bar
    local Top = New("Frame", {Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, Parent = Main})
    local mark = New("Frame", {Position = UDim2.fromOffset(14, 11), Size = UDim2.fromOffset(4, 18), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = Top})
    Corner(mark, 2)
    Gradient(mark, 90)
    local tl = New("Frame", {Position = UDim2.fromOffset(26, 0), Size = UDim2.new(1, -80, 1, 0), BackgroundTransparency = 1, Parent = Top})
    New("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = tl})
    if cfg.Icon then MakeIcon(tl, cfg.Icon, 18, WHITE, {LayoutOrder = 0}) end
    Txt(tl, {Text = cfg.Title or "SAKURA UI", Font = Enum.Font.GothamBold, TextSize = 15, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 20), LayoutOrder = 1})
    Txt(tl, {Text = cfg.Subtitle or "", TextSize = 12, TextColor3 = Theme.Sub, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 20), LayoutOrder = 2})

    local minBtn = New("TextButton", {
        AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -8, 0, 20), Size = UDim2.fromOffset(28, 26),
        BackgroundColor3 = Theme.Row, AutoButtonColor = false, Text = "—", Font = Enum.Font.GothamBold, TextSize = 14,
        TextColor3 = Theme.Text, BorderSizePixel = 0, Parent = Top,
    })
    Corner(minBtn, 5)
    minBtn.MouseEnter:Connect(function() Tween(minBtn, .15, {BackgroundColor3 = Theme.Purple}) end)
    minBtn.MouseLeave:Connect(function() Tween(minBtn, .15, {BackgroundColor3 = Theme.Row}) end)

    Drag(Top, Main)

    -- sidebar + pages
    local Side = New("Frame", {Position = UDim2.fromOffset(6, 44), Size = UDim2.new(0, SW, 1, -50), BackgroundColor3 = Theme.Side, BorderSizePixel = 0, Parent = Main})
    Corner(Side, 6)
    local TabList = New("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 0,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = Side,
    })
    New("UIListLayout", {Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = TabList})
    New("UIPadding", {PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), Parent = TabList})

    local Pages = New("Frame", {
        Position = UDim2.fromOffset(SW + 12, 44), Size = UDim2.new(1, -(SW + 18), 1, -50),
        BackgroundTransparency = 1, ClipsDescendants = true, Parent = Main,
    })

    -----------------------------------------------------------------
    -- floating toggle button (สี่เหลี่ยม UICorner + สีไล่ / ใส่รูปได้)
    -----------------------------------------------------------------
    local Float, FloatIcon, isPhoto
    local visible = false

    local function buildFloatIcon()
        if not Float then return end
        if FloatIcon then FloatIcon:Destroy(); FloatIcon = nil end
        local r = Win.ToggleImage and ResolveIcon(Win.ToggleImage)
        if r and r.Image then
            isPhoto = true
            FloatIcon = New("ImageLabel", {
                Name = "Icon", BackgroundTransparency = 1, Image = r.Image, ScaleType = Enum.ScaleType.Crop,
                Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, ZIndex = 2, Parent = Float,
            })
            if r.RectOffset then FloatIcon.ImageRectOffset = r.RectOffset; FloatIcon.ImageRectSize = r.RectSize end
            Corner(FloatIcon, 10)
        else
            isPhoto = false
            FloatIcon = Txt(Float, {
                Text = (r and r.Text) or "✦", Font = Enum.Font.GothamBold, TextSize = math.floor(Win.FloatSize * .5),
                TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(.5, .5),
                Position = UDim2.fromScale(.5, .5), Size = UDim2.fromScale(1, 1), ZIndex = 2,
            })
            FloatIcon.Rotation = visible and 180 or 0
        end
    end

    function Win:SetVisible(v)
        if v == visible then return end
        visible = v
        if v then
            Main.Visible = true
            Tween(Scale, .4, {Scale = uiScale}, Enum.EasingStyle.Back)
        else
            local t = Tween(Scale, .22, {Scale = 0}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            t.Completed:Connect(function() if not visible then Main.Visible = false end end)
        end
        if FloatIcon and not isPhoto then Tween(FloatIcon, .35, {Rotation = v and 180 or 0}, Enum.EasingStyle.Back) end
    end
    function Win:Toggle() self:SetVisible(not visible) end
    function Win:Notify(o) Library:Notify(o) end
    function Win:Destroy()
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        Gui:Destroy()
    end

    -- ตั้งรูปปุ่มเปิด UI  (id เลข / "rbxassetid://..." / ชื่อไอคอน / nil = ใช้ค่าเริ่มต้น ✦)
    function Win:SetToggleImage(id)
        if id ~= nil then
            id = tostring(id):gsub("^%s+", ""):gsub("%s+$", "")
            if id == "" then id = nil end
        end
        Win.ToggleImage = id
        buildFloatIcon()
        if Float then
            local fs = Float:FindFirstChildOfClass("UIScale")
            if fs then
                Tween(fs, .08, {Scale = .85})
                task.delay(.08, function() Tween(fs, .3, {Scale = 1}, Enum.EasingStyle.Back) end)
            end
        end
        persist()
    end
    function Win:SetToggleSize(px)
        Win.FloatSize = math.clamp(px, 32, 96)
        if Float then
            Tween(Float, .2, {Size = UDim2.fromOffset(Win.FloatSize, Win.FloatSize)})
            if FloatIcon and not isPhoto then FloatIcon.TextSize = math.floor(Win.FloatSize * .5) end
        end
        persist()
    end
    function Win:ShowFloat(b) if Float then Float.Visible = b and true or false end end
    function Win:SetScale(n)
        uiScale = math.clamp(n, .6, 1.3)
        if visible then Tween(Scale, .2, {Scale = uiScale}) end
        persist()
    end
    function Win:SetToggleKey(k)
        Win.ToggleKey = k
        persist()
    end

    -- พื้นหลัง UI หลัก (id เลข / "rbxassetid://..." / nil = ไม่มีรูป)
    local function applyMainImage()
        local r = Win.MainImage and ResolveIcon(Win.MainImage)
        if r and r.Image then
            BG.Image = r.Image
            BG.ImageRectOffset = r.RectOffset or Vector2.new()
            BG.ImageRectSize = r.RectSize or Vector2.new()
            BG.ImageTransparency = Win.MainImageTransparency
            BG.Visible = true
            Tween(Side, .25, {BackgroundTransparency = .3})
            SetRowAlpha(.25)
        else
            BG.Visible = false
            BG.Image = ""
            Tween(Side, .25, {BackgroundTransparency = 0})
            SetRowAlpha(0)
        end
    end
    function Win:SetMainImage(id)
        Win.MainImage = NormId(id)
        applyMainImage()
        persist()
    end
    function Win:SetMainImageTransparency(a)
        Win.MainImageTransparency = math.clamp(a, 0, .95)
        BG.ImageTransparency = Win.MainImageTransparency
        persist()
    end
    applyMainImage()

    minBtn.MouseButton1Click:Connect(function() Win:SetVisible(false) end)

    if cfg.FloatButton ~= false then
        Float = New("TextButton", {
            Name = "Float", Text = "", AutoButtonColor = false, Position = UDim2.new(0, 16, .5, -24),
            Size = UDim2.fromOffset(Win.FloatSize, Win.FloatSize), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = Gui,
        })
        Corner(Float, 10)
        Gradient(Float, 45)
        local fs = Stroke(Float, WHITE, 2)
        Spin(New("UIGradient", {Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, WHITE), ColorSequenceKeypoint.new(.5, Theme.Purple), ColorSequenceKeypoint.new(1, WHITE),
        }), Parent = fs}), 2.5)
        local fscale = New("UIScale", {Scale = 1, Parent = Float})
        buildFloatIcon()
        Drag(Float, Float, function()
            Tween(fscale, .08, {Scale = .85})
            task.delay(.08, function() Tween(fscale, .25, {Scale = 1}, Enum.EasingStyle.Back) end)
            Win:Toggle()
        end)
    end

    connect(UIS.InputBegan, function(i, gp)
        if not gp and i.KeyCode == Win.ToggleKey then Win:Toggle() end
    end)

    -----------------------------------------------------------------
    -- tabs
    -----------------------------------------------------------------
    local Active
    function Win:CreateTab(name, icon)
        if type(name) == "table" then icon = name.Icon; name = name.Name end
        local btn = New("TextButton", {
            Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = Theme.Row,
            BackgroundTransparency = 1, BorderSizePixel = 0, LayoutOrder = #Win.Tabs + 1, Parent = TabList,
        })
        Corner(btn, 6)
        local ind = New("Frame", {AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 0, .5, 0), Size = UDim2.fromOffset(3, 16), BackgroundColor3 = WHITE, BackgroundTransparency = 1, BorderSizePixel = 0, Parent = btn})
        Corner(ind, 2)
        Gradient(ind, 90)

        local iconObj
        local lx = 12
        if icon then
            iconObj = MakeIcon(btn, icon, 16, Theme.Sub, {AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 12, .5, 0)})
            if iconObj then lx = 36 end
        end
        local iprop = iconObj and ColorProp(iconObj)
        local lbl = Txt(btn, {
            Text = name or "Tab", Position = UDim2.fromOffset(lx, 0), Size = UDim2.new(1, -(lx + 4), 1, 0),
            TextColor3 = Theme.Sub, TextTruncate = Enum.TextTruncate.AtEnd,
        })

        local page = New("ScrollingFrame", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false,
            ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Pink, CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = Pages,
        })
        New("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = page})
        New("UIPadding", {PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = page})

        local Tab = {Name = name}
        function Tab:Select()
            if Active == Tab then return end
            if Active then Active.Deselect() end
            Active = Tab
            page.Visible = true
            page.Position = UDim2.fromOffset(0, 14)
            Tween(page, .3, {Position = UDim2.new()})
            Tween(btn, .2, {BackgroundTransparency = 0})
            Tween(ind, .2, {BackgroundTransparency = 0})
            Tween(lbl, .2, {TextColor3 = Theme.Text})
            if iconObj then Tween(iconObj, .2, {[iprop] = Theme.Pink}) end
        end
        function Tab.Deselect()
            page.Visible = false
            Tween(btn, .2, {BackgroundTransparency = 1})
            Tween(ind, .2, {BackgroundTransparency = 1})
            Tween(lbl, .2, {TextColor3 = Theme.Sub})
            if iconObj then Tween(iconObj, .2, {[iprop] = Theme.Sub}) end
        end
        btn.MouseButton1Click:Connect(function() Tab:Select() end)
        btn.MouseEnter:Connect(function() if Active ~= Tab then Tween(lbl, .15, {TextColor3 = Theme.Text}) end end)
        btn.MouseLeave:Connect(function() if Active ~= Tab then Tween(lbl, .15, {TextColor3 = Theme.Sub}) end end)

        BuildElements(page, Tab, connect)
        table.insert(Win.Tabs, Tab)
        if #Win.Tabs == 1 then Tab:Select() end
        return Tab
    end

    -----------------------------------------------------------------
    -- หน้าปรับแต่ง (Customize) — ตั้งรูปปุ่มเปิด UI ด้วย ID ได้
    -----------------------------------------------------------------
    function Win:CreateSettingsTab(name, icon)
        local T = Win:CreateTab(name or "ปรับแต่ง / Customize", icon or "⚙")

        T:CreateSection("ปุ่มเปิด UI • Toggle Button")
        local idBox
        idBox = T:CreateTextbox({
            Name = "ไอดีรูป • Image ID", Icon = "🖼", Placeholder = "เช่น 79591093854416",
            Default = Win.ToggleImage and tostring(Win.ToggleImage) or "",
            Callback = function(text)
                Win:SetToggleImage(text)
                Library:Notify({
                    Title = (text ~= "" and "ตั้งรูปแล้ว • Image set" or "ใช้ไอคอนเริ่มต้น • Default icon"),
                    Content = text ~= "" and ("ID: " .. text) or "กลับไปใช้ปุ่ม ✦", Duration = 3,
                })
            end,
        })
        T:CreateButton({
            Name = "ล้างรูป • Reset Image", Icon = "↺",
            Callback = function() idBox:Set(""); Win:SetToggleImage(nil) end,
        })
        T:CreateSlider({
            Name = "ขนาดปุ่ม • Button Size", Min = 32, Max = 96, Default = Win.FloatSize, Suffix = "px",
            Callback = function(v) Win:SetToggleSize(v) end,
        })
        T:CreateToggle({
            Name = "แสดงปุ่มลอย • Show Button", Default = true,
            Callback = function(v) Win:ShowFloat(v) end,
        })

        T:CreateSection("พื้นหลัง UI • Background")
        local bgBox
        bgBox = T:CreateTextbox({
            Name = "ไอดีรูปพื้นหลัง • Main Image ID", Icon = "🖼", Placeholder = "ใส่ไอดีรูป...",
            Default = Win.MainImage and tostring(Win.MainImage) or "",
            Callback = function(text)
                Win:SetMainImage(text)
                Library:Notify({
                    Title = (text ~= "" and "ตั้งพื้นหลังแล้ว • Background set" or "ล้างพื้นหลังแล้ว • Cleared"),
                    Content = text ~= "" and ("ID: " .. text) or "กลับไปใช้พื้นสีเดิม", Duration = 3,
                })
            end,
        })
        T:CreateButton({
            Name = "ล้างพื้นหลัง • Reset Background", Icon = "↺",
            Callback = function() bgBox:Set(""); Win:SetMainImage(nil) end,
        })
        T:CreateSlider({
            Name = "ความชัดรูป • Image Opacity", Min = 5, Max = 100, Increment = 5, Suffix = "%",
            Default = math.floor((1 - Win.MainImageTransparency) * 100 + .5),
            Callback = function(v) Win:SetMainImageTransparency(1 - v / 100) end,
        })

        T:CreateSection("หน้าต่าง • Window")
        T:CreateSlider({
            Name = "ขนาด UI • UI Scale", Min = 60, Max = 130, Increment = 5, Default = math.floor(uiScale * 100 + .5), Suffix = "%",
            Callback = function(v) Win:SetScale(v / 100) end,
        })
        T:CreateKeybind({
            Name = "ปุ่มเปิด/ปิด UI • Toggle Key", Default = Win.ToggleKey,
            Changed = function(k) Win:SetToggleKey(k) end,
        })
        T:CreateButton({
            Name = "ปิดสคริปต์ • Destroy UI", Icon = "✕",
            Callback = function() Win:Destroy() end,
        })
        return T
    end

    if cfg.AutoOpen ~= false then task.defer(function() Win:SetVisible(true) end) end
    return Win
end

