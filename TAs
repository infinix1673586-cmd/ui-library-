--[[
    SAKURA UI LIBRARY v2.0
    Minimal Window + Tabs + Icons + Sakura Background
    Roblox Luau

    Example:
        local Library = loadstring(game:HttpGet("YOUR_RAW_URL"))()

        Library:RegisterIcons({
            Home = "rbxassetid://123456789",
            Player = "🌸",
        })

        local Window = Library:CreateWindow({
            Title = "Xเกรียน",
            Subtitle = "KOMAT UNITY HUB",
            ToggleImage = 79591093854416,
            MainImage = "rbxassetid://123456789", -- optional background image
        })

        local MainTab = Window:CreateTab("เมนูหลัก", "Home")
        local PlayerTab = Window:CreateTab("ผู้เล่น", "Player")

        -- Add your own UI objects to the tab's content container:
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -20, 0, 36)
        label.Position = UDim2.fromOffset(10, 10)
        label.BackgroundTransparency = 1
        label.Text = "สวัสดีจาก Sakura UI"
        label.TextColor3 = Color3.fromRGB(255, 240, 250)
        label.Parent = MainTab.Content

    Icon formats:
        "🌸"                              Emoji
        123456789                         Asset ID
        "rbxassetid://123456789"          Roblox image URI
        "Home"                            Registered icon name
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local Library = {
    Version = "2.0",
    Icons = {},
    Windows = {},
}

local Theme = {
    Background = Color3.fromRGB(25, 18, 34),
    Panel = Color3.fromRGB(36, 25, 48),
    PanelLight = Color3.fromRGB(51, 34, 65),
    Pink = Color3.fromRGB(255, 132, 190),
    PinkLight = Color3.fromRGB(255, 190, 220),
    Purple = Color3.fromRGB(157, 112, 220),
    Text = Color3.fromRGB(255, 242, 250),
    Muted = Color3.fromRGB(190, 169, 198),
    Stroke = Color3.fromRGB(111, 76, 130),
}

local function create(className, properties, parent)
    local object = Instance.new(className)
    for property, value in pairs(properties or {}) do
        object[property] = value
    end
    object.Parent = parent
    return object
end

local function addCorner(parent, radius)
    return create("UICorner", {
        CornerRadius = UDim.new(0, radius or 10),
    }, parent)
end

local function addStroke(parent, color, transparency, thickness)
    return create("UIStroke", {
        Color = color or Theme.Stroke,
        Transparency = transparency or 0,
        Thickness = thickness or 1,
    }, parent)
end

local function addGradient(parent, colorA, colorB, rotation)
    return create("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, colorA),
            ColorSequenceKeypoint.new(1, colorB),
        }),
        Rotation = rotation or 0,
    }, parent)
end

local function resolveIcon(icon)
    if icon == nil then
        return nil, nil
    end

    if typeof(icon) == "number" then
        return "image", "rbxassetid://" .. tostring(icon)
    end

    if typeof(icon) ~= "string" then
        return nil, nil
    end

    local registered = Library.Icons[icon]
    if registered ~= nil then
        return resolveIcon(registered)
    end

    if string.match(icon, "^rbxassetid://") then
        return "image", icon
    end

    if string.match(icon, "^%d+$") then
        return "image", "rbxassetid://" .. icon
    end

    -- Any other short string is treated as an emoji / text icon.
    return "text", icon
end

function Library:RegisterIcons(iconTable)
    assert(typeof(iconTable) == "table", "RegisterIcons expects a table")

    for name, icon in pairs(iconTable) do
        if typeof(name) == "string" then
            self.Icons[name] = icon
        end
    end

    return self
end

local function makeIcon(parent, icon, size, position)
    local kind, value = resolveIcon(icon)
    if not kind then
        return nil
    end

    if kind == "image" then
        return create("ImageLabel", {
            Name = "Icon",
            BackgroundTransparency = 1,
            Image = value,
            ImageColor3 = Color3.new(1, 1, 1),
            ScaleType = Enum.ScaleType.Fit,
            Size = size,
            Position = position or UDim2.new(),
        }, parent)
    end

    return create("TextLabel", {
        Name = "Icon",
        BackgroundTransparency = 1,
        Text = value,
        TextColor3 = Theme.PinkLight,
        TextScaled = true,
        Font = Enum.Font.Gotham,
        Size = size,
        Position = position or UDim2.new(),
    }, parent)
end

local function addSakuraDecor(parent)
    local symbols = {"✿", "❀", "✧", "✿", "❁", "·"}
    for index = 1, 13 do
        local symbol = symbols[((index - 1) % #symbols) + 1]
        local x = ((index * 37) % 97) / 100
        local y = ((index * 23) % 91) / 100
        local label = create("TextLabel", {
            Name = "SakuraDecoration",
            BackgroundTransparency = 1,
            Text = symbol,
            TextColor3 = (index % 2 == 0) and Theme.Pink or Theme.Purple,
            TextTransparency = 0.82,
            TextSize = 13 + (index % 4) * 4,
            Font = Enum.Font.Gotham,
            Size = UDim2.fromOffset(24, 24),
            Position = UDim2.new(x, 0, y, 0),
            Rotation = (index * 29) % 360,
            ZIndex = 0,
        }, parent)

        local drift = TweenService:Create(
            label,
            TweenInfo.new(4 + (index % 4), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
            {
                Position = label.Position + UDim2.fromOffset((index % 2 == 0) and 7 or -7, 8),
                Rotation = label.Rotation + 35,
            }
        )
        drift:Play()
    end
end

local WindowMethods = {}
WindowMethods.__index = WindowMethods

function WindowMethods:CreateTab(name, icon)
    assert(typeof(name) == "string", "CreateTab expects a tab name")

    local tabIndex = #self.Tabs + 1
    local button = create("TextButton", {
        Name = "Tab_" .. tostring(tabIndex),
        AutoButtonColor = false,
        BackgroundColor3 = Theme.PanelLight,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Text = "",
        Size = UDim2.new(1, 0, 0, 39),
        LayoutOrder = tabIndex,
    }, self.TabList)
    addCorner(button, 9)

    local iconObject = makeIcon(button, icon, UDim2.fromOffset(20, 20), UDim2.fromOffset(11, 9))
    local textX = iconObject and 40 or 13

    create("TextLabel", {
        Name = "TabName",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(textX, 0),
        Size = UDim2.new(1, -textX - 8, 1, 0),
        Font = Enum.Font.GothamMedium,
        Text = name,
        TextColor3 = Theme.Muted,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, button)

    local page = create("ScrollingFrame", {
        Name = "Page_" .. tostring(tabIndex),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Pink,
        Visible = false,
    }, self.PageHolder)

    create("UIPadding", {
        PaddingTop = UDim.new(0, 12),
        PaddingBottom = UDim.new(0, 12),
        PaddingLeft = UDim.new(0, 12),
        PaddingRight = UDim.new(0, 12),
    }, page)

    local tab = {
        Name = name,
        Button = button,
        Content = page,
        Window = self,
    }

    function tab:SetName(newName)
        self.Name = tostring(newName)
        local label = self.Button:FindFirstChild("TabName")
        if label then
            label.Text = self.Name
        end
    end

    function tab:SetIcon(newIcon)
        local oldIcon = self.Button:FindFirstChild("Icon")
        if oldIcon then
            oldIcon:Destroy()
        end
        local newObject = makeIcon(self.Button, newIcon, UDim2.fromOffset(20, 20), UDim2.fromOffset(11, 9))
        local label = self.Button:FindFirstChild("TabName")
        if label then
            label.Position = UDim2.fromOffset(newObject and 40 or 13, 0)
            label.Size = UDim2.new(1, -(newObject and 48 or 21), 1, 0)
        end
    end

    function tab:Show()
        self.Window:SelectTab(self)
    end

    button.MouseButton1Click:Connect(function()
        self:Show()
    end)

    table.insert(self.Tabs, tab)
    if not self.SelectedTab then
        self:SelectTab(tab)
    end

    return tab
end

function WindowMethods:SelectTab(tab)
    if typeof(tab) == "number" then
        tab = self.Tabs[tab]
    end
    if not tab then
        return
    end

    for _, item in ipairs(self.Tabs) do
        local selected = item == tab
        item.Content.Visible = selected
        item.Button.BackgroundTransparency = selected and 0 or 1

        local label = item.Button:FindFirstChild("TabName")
        if label then
            label.TextColor3 = selected and Theme.Text or Theme.Muted
        end

        local icon = item.Button:FindFirstChild("Icon")
        if icon then
            if icon:IsA("ImageLabel") then
                icon.ImageColor3 = selected and Theme.PinkLight or Theme.Muted
            elseif icon:IsA("TextLabel") then
                icon.TextColor3 = selected and Theme.PinkLight or Theme.Muted
            end
        end
    end

    self.SelectedTab = tab
    self.PageTitle.Text = tab.Name
end

function WindowMethods:SetVisible(state)
    self.ScreenGui.Enabled = state == true
    self.Visible = state == true
end

function WindowMethods:Toggle()
    self:SetVisible(not self.Visible)
end

function WindowMethods:SetToggleImage(image)
    if self.FloatButton then
        local kind, value = resolveIcon(image)
        if kind == "image" then
            self.FloatButton.Image = value
        end
    end
end

function WindowMethods:Destroy()
    if self.ScreenGui then
        self.ScreenGui:Destroy()
    end
    for index, window in ipairs(Library.Windows) do
        if window == self then
            table.remove(Library.Windows, index)
            break
        end
    end
end

function Library:CreateWindow(config)
    config = config or {}

    local playerGui = LocalPlayer:WaitForChild("PlayerGui")
    local screenGui = create("ScreenGui", {
        Name = "SakuraUI_" .. tostring(#self.Windows + 1),
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
    }, playerGui)

    local width = tonumber(config.Width) or 660
    local height = tonumber(config.Height) or 420
    local windowFrame = create("Frame", {
        Name = "MainWindow",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(width, height),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true,
    }, screenGui)
    addCorner(windowFrame, 16)
    addStroke(windowFrame, Theme.Stroke, 0.18, 1.2)
    addGradient(windowFrame, Color3.fromRGB(38, 24, 49), Color3.fromRGB(20, 17, 31), 35)

    local decor = create("Frame", {
        Name = "SakuraBackground",
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 0,
    }, windowFrame)
    addSakuraDecor(decor)

    local top = create("Frame", {
        Name = "TopBar",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 66),
        ZIndex = 2,
    }, windowFrame)

    local title = create("TextLabel", {
        Name = "Title",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(19, 10),
        Size = UDim2.new(1, -100, 0, 25),
        Font = Enum.Font.GothamBold,
        Text = tostring(config.Title or "SAKURA UI"),
        TextColor3 = Theme.Text,
        TextSize = 18,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, top)

    create("TextLabel", {
        Name = "Subtitle",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(20, 36),
        Size = UDim2.new(1, -100, 0, 17),
        Font = Enum.Font.Gotham,
        Text = tostring(config.Subtitle or "Minimal Interface"),
        TextColor3 = Theme.Muted,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, top)

    local closeButton = create("TextButton", {
        Name = "Close",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -13, 0, 13),
        Size = UDim2.fromOffset(29, 29),
        BackgroundColor3 = Color3.fromRGB(91, 48, 78),
        AutoButtonColor = false,
        Text = "×",
        TextColor3 = Theme.Text,
        TextSize = 21,
        Font = Enum.Font.Gotham,
    }, top)
    addCorner(closeButton, 8)

    local body = create("Frame", {
        Name = "Body",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(12, 70),
        Size = UDim2.new(1, -24, 1, -82),
        ZIndex = 2,
    }, windowFrame)

    local sidebar = create("Frame", {
        Name = "Sidebar",
        BackgroundColor3 = Theme.Panel,
        BackgroundTransparency = 0.08,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 166, 1, 0),
    }, body)
    addCorner(sidebar, 12)
    addStroke(sidebar, Theme.Stroke, 0.45, 1)

    local tabList = create("ScrollingFrame", {
        Name = "TabList",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(8, 10),
        Size = UDim2.new(1, -16, 1, -20),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Theme.Pink,
    }, sidebar)

    create("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, tabList)

    local contentFrame = create("Frame", {
        Name = "ContentFrame",
        BackgroundColor3 = Theme.Panel,
        BackgroundTransparency = 0.12,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(176, 0),
        Size = UDim2.new(1, -176, 1, 0),
        ClipsDescendants = true,
    }, body)
    addCorner(contentFrame, 12)
    addStroke(contentFrame, Theme.Stroke, 0.48, 1)

    local pageTitle = create("TextLabel", {
        Name = "PageTitle",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(14, 8),
        Size = UDim2.new(1, -28, 0, 28),
        Font = Enum.Font.GothamBold,
        Text = "เลือกเมนู",
        TextColor3 = Theme.PinkLight,
        TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 3,
    }, contentFrame)

    local pageHolder = create("Frame", {
        Name = "PageHolder",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(0, 40),
        Size = UDim2.new(1, 0, 1, -40),
        ZIndex = 2,
    }, contentFrame)

    local window = setmetatable({
        ScreenGui = screenGui,
        Frame = windowFrame,
        Tabs = {},
        TabList = tabList,
        PageHolder = pageHolder,
        PageTitle = pageTitle,
        Visible = true,
    }, WindowMethods)

    closeButton.MouseButton1Click:Connect(function()
        window:Destroy()
    end)

    -- Drag window using the top bar.
    local dragging = false
    local dragStart, startPosition

    top.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPosition = windowFrame.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            windowFrame.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- Optional floating image button for showing / hiding the window.
    local toggleImage = config.ToggleImage
    if toggleImage ~= nil then
        local kind, value = resolveIcon(toggleImage)
        if kind == "image" then
            local floatButton = create("ImageButton", {
                Name = "SakuraToggle",
                Size = UDim2.fromOffset(54, 54),
                Position = UDim2.new(0, 18, 0.5, -27),
                BackgroundColor3 = Theme.Panel,
                Image = value,
                ScaleType = Enum.ScaleType.Crop,
                AutoButtonColor = true,
            }, screenGui)
            addCorner(floatButton, 16)
            addStroke(floatButton, Theme.Pink, 0.15, 1.5)
            floatButton.MouseButton1Click:Connect(function()
                window:SetVisible(not window.Visible)
            end)
            window.FloatButton = floatButton
        end
    end

    -- Optional image overlay behind the Sakura decoration.
    if config.MainImage then
        local mainImage = config.MainImage
        local imageKind, imageValue = resolveIcon(mainImage)
        if imageKind == "image" then
            local image = create("ImageLabel", {
                Name = "MainBackgroundImage",
                BackgroundTransparency = 1,
                Image = imageValue,
                ImageTransparency = tonumber(config.MainImageTransparency) or 0.88,
                ScaleType = Enum.ScaleType.Crop,
                Size = UDim2.fromScale(1, 1),
                ZIndex = 0,
            }, windowFrame)
            image.LayoutOrder = -1
        end
    end

    table.insert(self.Windows, window)
    return window
end

return Library
