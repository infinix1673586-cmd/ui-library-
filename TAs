    -- Alias for libraries/scripts that use CreateInput instead of CreateTextbox.
    object.CreateInput = object.CreateTextbox

    function object:CreateKeybind(options)
        options = options or {}
        local key = options.Default or Enum.KeyCode.Unknown
        local row, outline = MakeRow(page, 42)
        LabelName(row, options, "Keybind", 115)
        local button = New("TextButton", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
            Size = UDim2.fromOffset(88, 27), BackgroundColor3 = Theme.Input,
